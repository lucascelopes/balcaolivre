<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>BalcaoLivrePDV</AssemblyName>
    <Product>Balcão Livre PDV</Product>
    <AssemblyTitle>Balcão Livre PDV</AssemblyTitle>
    <Company>Nagazaki Software</Company>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>1.2.2026</Version>
    <AssemblyVersion>1.2.2026.0</AssemblyVersion>
    <FileVersion>1.2.2026.0</FileVersion>
    <InformationalVersion>1.2.2026</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="obj\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\app.ico" />
    <Resource Include="Assets\app.ico" />
    <Content Include="Assets\setup-logo.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

</Project>
