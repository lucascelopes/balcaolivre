<Window x:Class="BalcaoLivre.Online.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Balcao Livre PDV Online"
        Width="1360"
        Height="830"
        MinWidth="1180"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#EEF2F5"
        FontFamily="Segoe UI"
        Icon="Assets/app.ico"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewTextInput="Window_PreviewTextInput">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#18222B"/>
        <SolidColorBrush x:Key="Muted" Color="#667684"/>
        <SolidColorBrush x:Key="Line" Color="#D5DEE7"/>
        <SolidColorBrush x:Key="Panel" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Blue" Color="#2F6FAE"/>
        <SolidColorBrush x:Key="BlueDark" Color="#245B91"/>
        <SolidColorBrush x:Key="Green" Color="#7FD39B"/>
        <SolidColorBrush x:Key="GreenSoft" Color="#EAF8EF"/>
        <SolidColorBrush x:Key="AmberSoft" Color="#FFF2CB"/>
        <SolidColorBrush x:Key="RedSoft" Color="#FFE2DF"/>
        <SolidColorBrush x:Key="Accent" Color="#0F766E"/>

        <Style x:Key="PanelCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.055" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TopButton" TargetType="Button">
            <Setter Property="Width" Value="90"/>
            <Setter Property="Height" Value="94"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#D5DEE7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F3F9FF"/>
                                <Setter Property="BorderBrush" Value="#8AB7E6"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="Background" Value="#F3F9FF"/>
                                <Setter Property="BorderBrush" Value="#2F6FAE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RibbonNavButton" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="94"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#D5DEE7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F3F9FF"/>
                                <Setter Property="BorderBrush" Value="#8AB7E6"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="Background" Value="#F3F9FF"/>
                                <Setter Property="BorderBrush" Value="#2F6FAE"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.36"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CommandButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource CommandButton}">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderBrush" Value="#B7C6D4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>

        <Style x:Key="ModeListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="RibbonButtonTemplate">
            <Button x:Name="RibbonActionButton"
                    Style="{StaticResource TopButton}"
                    Click="RibbonButton_Click"
                    Tag="{Binding Id}"
                    ToolTip="{Binding Title}"
                    AutomationProperties.Name="{Binding Title}">
                <StackPanel>
                    <Border x:Name="ShortcutBadge" Width="34" Height="30" CornerRadius="6" Background="#E8F1FA" HorizontalAlignment="Center" Margin="0,0,0,6">
                        <TextBlock x:Name="ShortcutText" Text="{Binding KeyText}" Foreground="#245B91" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource Ink}" FontSize="12" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource Muted}" FontSize="10" TextAlignment="Center"/>
                </StackPanel>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="TransferBoardTemplate">
            <Border x:Name="TransferCard" Background="#F8FBFE" BorderBrush="#D8E2EC" BorderThickness="1" CornerRadius="9" Padding="12">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" Margin="12,0,0,0">
                        <TextBlock Text="{Binding TransferTotalText}" Foreground="#0F766E" FontSize="15" FontWeight="Bold" HorizontalAlignment="Right"/>
                        <Border Background="{Binding TileBrush}" CornerRadius="7" Padding="7,2" Margin="0,6,0,0" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding Status}" Foreground="#17351F" FontSize="10" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding DisplayTitle}" Foreground="#18222B" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding TransferSubtitle}" Foreground="#667684" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding TransferHint}" Foreground="#245B91" FontSize="11" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                    <Setter TargetName="TransferCard" Property="Background" Value="#EAF4FF"/>
                    <Setter TargetName="TransferCard" Property="BorderBrush" Value="#245B91"/>
                    <Setter TargetName="TransferCard" Property="BorderThickness" Value="2"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="ModeTemplate">
            <Border x:Name="ModeRoot" Background="#FFFFFF" BorderBrush="#D8E2EC" BorderThickness="1" CornerRadius="9" Padding="20,0" Height="34" MinWidth="110">
                <TextBlock x:Name="ModeText" Text="{Binding}" Foreground="{StaticResource Ink}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True">
                    <Setter TargetName="ModeRoot" Property="Background" Value="#EEF5FB"/>
                    <Setter TargetName="ModeRoot" Property="BorderBrush" Value="#BFD8EF"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                    <Setter TargetName="ModeRoot" Property="Background" Value="#245B91"/>
                    <Setter TargetName="ModeRoot" Property="BorderBrush" Value="#245B91"/>
                    <Setter TargetName="ModeText" Property="Foreground" Value="White"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="TableTemplate">
            <Border x:Name="TableRoot" Background="#FFFFFF" BorderBrush="#D8E2EC" BorderThickness="1" CornerRadius="8" Margin="0,0,7,7" Width="84" Height="78" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Background="{Binding TileBrush}" CornerRadius="8,8,0,0"/>
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="5,1,5,5">
                        <TextBlock Text="{Binding DisplayTitle}" Foreground="{StaticResource Ink}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding DisplaySubtitle}" Foreground="{StaticResource Muted}" FontSize="8" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                        <TextBlock x:Name="TileTimerText" Text="{Binding TimerText}" Foreground="{Binding TimerBrush}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                        <Border Background="{Binding TileBrush}" CornerRadius="7" Padding="5,1" HorizontalAlignment="Center" Margin="0,2,0,0">
                            <TextBlock Text="{Binding Status}" Foreground="#17351F" FontSize="8" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="TableRoot" Property="BorderBrush" Value="#1F4E79"/>
                    <Setter TargetName="TableRoot" Property="BorderThickness" Value="2"/>
                    <Setter TargetName="TableRoot" Property="Background" Value="#F7FBFF"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding TimerText}" Value="">
                    <Setter TargetName="TileTimerText" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="CategoryTemplate">
            <Border x:Name="CategoryRoot" Background="#FFFFFF" BorderBrush="#D8E2EC" BorderThickness="1" CornerRadius="8" Padding="14,0" Margin="0,0,8,8" Width="126" Height="46">
                <TextBlock x:Name="CategoryText" Text="{Binding Name}" Foreground="{StaticResource Ink}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="CategoryRoot" Property="Background" Value="#E8F1FA"/>
                    <Setter TargetName="CategoryRoot" Property="BorderBrush" Value="#2F6FAE"/>
                    <Setter TargetName="CategoryText" Property="Foreground" Value="#245B91"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="ProductTemplate">
            <Border x:Name="ProductRoot" Background="#FFFFFF" BorderBrush="#D8E2EC" BorderThickness="1" CornerRadius="7" Margin="0,0,0,6" Height="48" ClipToBounds="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="82"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="112"/>
                        <ColumnDefinition Width="92"/>
                        <ColumnDefinition Width="86"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="ProductAccent" Background="Transparent"/>
                    <TextBlock Grid.Column="1" Text="{Binding Code}" Foreground="{StaticResource Muted}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <TextBlock Grid.Column="2" Text="{Binding Name}" Foreground="{StaticResource Ink}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="3" Text="{Binding Category}" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="4" Text="{Binding PriceText}" Foreground="{StaticResource Accent}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <TextBlock Grid.Column="5" Text="{Binding StockQuantity, StringFormat=Est. {0:N0}}" Foreground="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="ProductRoot" Property="BorderBrush" Value="#0F766E"/>
                    <Setter TargetName="ProductRoot" Property="Background" Value="#F5FFFC"/>
                    <Setter TargetName="ProductAccent" Property="Background" Value="#0F766E"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="TicketLineTemplate">
            <Border x:Name="LineRoot" BorderBrush="#DFE7EE" BorderThickness="0,0,0,1" Padding="8,7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="58"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="78"/>
                        <ColumnDefinition Width="62"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Code}" Foreground="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{StaticResource Ink}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="2" Text="{Binding Quantity}" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="{Binding TotalText}" HorizontalAlignment="Right" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <Button Grid.Column="4"
                            x:Name="DeleteLineButton"
                            Content="Excluir"
                            Click="DeleteTicketLineButton_Click"
                            Background="#A11D1D"
                            Foreground="White"
                            BorderBrush="#A11D1D"
                            BorderThickness="1"
                            FontWeight="SemiBold"
                            Height="24"
                            Padding="6,0"
                            Margin="8,-2,0,-2"
                            Cursor="Hand"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding CanDelete}" Value="False">
                    <Setter TargetName="DeleteLineButton" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="54"/>
            <RowDefinition Height="118"/>
            <RowDefinition Height="46"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource BlueDark}">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Width="38" Height="38" Margin="0,0,10,0" VerticalAlignment="Center">
                    <Border x:Name="BrandLogoFallback" Background="#FFFFFF" CornerRadius="8">
                        <TextBlock Text="RP" Foreground="{StaticResource BlueDark}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border CornerRadius="8" ClipToBounds="True">
                        <Image x:Name="BrandLogoImage" Stretch="UniformToFill" Visibility="Collapsed"/>
                    </Border>
                </Grid>
                <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock x:Name="BrandNameText" Text="Balcão Livre PDV" Foreground="White" FontWeight="Bold" FontSize="16"/>
                        <TextBlock x:Name="BrandMetaText" Text="PDV online com iFood" Foreground="#DDEBFA" FontSize="11"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Button
                        MinWidth="112"
                        Height="34"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="#0F766E"
                        BorderBrush="#BDE5DD"
                        BorderThickness="1"
                        Foreground="#FFFFFF"
                        FontWeight="Bold"
                        FocusVisualStyle="{x:Null}"
                        Cursor="Hand"
                        Click="WhatsAppButton_Click"
                        ToolTip="Ativar WhatsApp automatico">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="12,0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#0B625B"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="18" Height="18" CornerRadius="9" Background="#E8F7F4" Margin="0,0,7,0">
                            <TextBlock Text="WA" Foreground="#0F766E" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="WhatsApp" FontSize="13" FontWeight="SemiBold"/>
                    </StackPanel>
                    </Button>
                    <Button
                        MinWidth="104"
                        Height="34"
                        Margin="8,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="#E8F7F4"
                        BorderBrush="#BDE5DD"
                        BorderThickness="1"
                        Foreground="#0F766E"
                        FontWeight="Bold"
                        FocusVisualStyle="{x:Null}"
                        Cursor="Hand"
                        Click="SupportButton_Click"
                        ToolTip="Suporte em tempo real">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="12,0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#D8F0EB"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="16" Height="16" Margin="0,0,7,0">
                            <Ellipse Width="14" Height="14" Stroke="#0F766E" StrokeThickness="1.7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Text="?" Foreground="#0F766E" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                        </Grid>
                        <TextBlock Text="Suporte" FontSize="13" FontWeight="SemiBold"/>
                    </StackPanel>
                    </Button>
                    <Button
                        MinWidth="92"
                        Height="34"
                        Margin="8,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="#FFFFFF"
                        BorderBrush="#DDEBFA"
                        BorderThickness="1"
                        Foreground="{StaticResource BlueDark}"
                        FontWeight="Bold"
                        FocusVisualStyle="{x:Null}"
                        Cursor="Hand"
                        Click="SettingsButton_Click"
                        ToolTip="Configuracoes do sistema">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="12,0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#E8F1FA"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="16" Height="16" Margin="0,0,7,0">
                            <Ellipse Width="12" Height="12" Stroke="{StaticResource BlueDark}" StrokeThickness="1.7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Ellipse Width="4" Height="4" Fill="{StaticResource BlueDark}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Path Stroke="{StaticResource BlueDark}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M8,0 L8,3 M8,13 L8,16 M0,8 L3,8 M13,8 L16,8 M2.4,2.4 L4.5,4.5 M11.5,11.5 L13.6,13.6 M13.6,2.4 L11.5,4.5 M4.5,11.5 L2.4,13.6"/>
                        </Grid>
                        <TextBlock Text="Config" FontSize="13" FontWeight="SemiBold"/>
                    </StackPanel>
                    </Button>
                    </StackPanel>
                </Grid>
                <TextBlock Grid.Column="2" Text="Setas navegam  |  Enter confirma  |  Numerico digita codigo  |  F2 incluir  F4 cozinha  F5 fechar  F8 antecipado  F9 receber  F10 abrir/fechar caixa" Foreground="#DDEBFA" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#F9FBFD" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <Grid Margin="10,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="RibbonLeftButton"
                        Grid.Column="0"
                        Style="{StaticResource RibbonNavButton}"
                        Click="RibbonScrollLeft_Click"
                        ToolTip="Voltar acoes">
                    <Path Width="10" Height="18" Stroke="{StaticResource BlueDark}" StrokeThickness="2.2" Data="M 8 2 L 2 9 L 8 16" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                </Button>
                <ScrollViewer x:Name="RibbonScrollViewer"
                              Grid.Column="1"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled"
                              PreviewMouseWheel="RibbonScrollViewer_PreviewMouseWheel"
                              ScrollChanged="RibbonScrollViewer_ScrollChanged"
                              SizeChanged="RibbonScrollViewer_SizeChanged"
                              Loaded="RibbonScrollViewer_Loaded"
                              PanningMode="HorizontalOnly"
                              Padding="0,0,8,0">
                    <ItemsControl ItemsSource="{Binding RibbonActions}" ItemTemplate="{StaticResource RibbonButtonTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Margin" Value="0,0,8,0"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                    </ItemsControl>
                </ScrollViewer>
                <Button x:Name="RibbonRightButton"
                        Grid.Column="2"
                        Style="{StaticResource RibbonNavButton}"
                        Click="RibbonScrollRight_Click"
                        ToolTip="Avancar acoes">
                    <Path Width="10" Height="18" Stroke="{StaticResource BlueDark}" StrokeThickness="2.2" Data="M 2 2 L 8 9 L 2 16" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                </Button>
                <Border Grid.Column="3" Background="#FFFFFF" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                    <StackPanel>
                        <TextBlock x:Name="CashStatusText" Text="Caixa aberto" Foreground="{StaticResource Muted}" FontSize="12"/>
                        <TextBlock x:Name="CashTotalText" Text="R$ 0,00" Foreground="{StaticResource Accent}" FontSize="22" FontWeight="Bold"/>
                        <TextBlock x:Name="TodaySalesText" Text="Vendas hoje: R$ 0,00" Foreground="{StaticResource Muted}" FontSize="12" FontWeight="SemiBold" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Background="#F8FBFD">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ListBox x:Name="ModeList"
                     ItemsSource="{Binding Modes}"
                     ItemTemplate="{StaticResource ModeTemplate}"
                     ItemContainerStyle="{StaticResource ModeListItemStyle}"
                     SelectionChanged="ModeList_SelectionChanged"
                     BorderThickness="0"
                     Background="Transparent"
                     Margin="12,6,0,6"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
            <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#D8E2EC" BorderThickness="1" CornerRadius="8" Padding="12,5" Margin="0,6,10,6">
                <TextBlock x:Name="ActiveAreaText" Text="Area: Produtos" Foreground="{StaticResource Ink}" FontWeight="SemiBold"/>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="440"/>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelCard}" Margin="0,0,10,0">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="86"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="CommandTitleText" Text="Comanda" Foreground="{StaticResource Ink}" FontSize="24" FontWeight="SemiBold"/>

                    <Grid Grid.Row="1" Margin="0,12,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="88"/>
                            <ColumnDefinition Width="96"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="58"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="TableFieldLabel" Text="Mesa / cliente" Foreground="{StaticResource Muted}" FontWeight="SemiBold"/>
                            <TextBox x:Name="TableBox" Text="000001" GotKeyboardFocus="CommandTextBox_GotKeyboardFocus"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock x:Name="WaiterFieldLabel" Text="Oper/Garcom" Foreground="{StaticResource Muted}" FontWeight="SemiBold"/>
                            <TextBox x:Name="WaiterBox" Text="1" GotKeyboardFocus="CommandTextBox_GotKeyboardFocus"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="8,0,0,0">
                            <TextBlock Text="Codigo" Foreground="{StaticResource Muted}" FontWeight="SemiBold"/>
                            <TextBox x:Name="CodeBox" Text="" TextChanged="CodeBox_TextChanged" GotKeyboardFocus="CommandTextBox_GotKeyboardFocus"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Margin="8,0,0,0">
                            <TextBlock Text="Qtd" Foreground="{StaticResource Muted}" FontWeight="SemiBold"/>
                            <TextBox x:Name="QuantityBox" Text="1" GotKeyboardFocus="CommandTextBox_GotKeyboardFocus"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="86"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="112"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Couvert" Foreground="{StaticResource Muted}" FontWeight="SemiBold"/>
                            <TextBox x:Name="PriceBox" Text="0,00" GotKeyboardFocus="CommandTextBox_GotKeyboardFocus"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="% Garcom" Foreground="{StaticResource Muted}" FontWeight="SemiBold"/>
                            <TextBox x:Name="NoteBox" Text="10" GotKeyboardFocus="CommandTextBox_GotKeyboardFocus"/>
                        </StackPanel>
                        <Button Grid.Column="2" x:Name="ChargeToggleButton" Content="Ativar" Click="ConfirmInclude_Click" Style="{StaticResource CommandButton}" Margin="8,19,0,0"/>
                    </Grid>

                    <Border Grid.Row="3" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Background="#F3F6F8" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                                <Grid Margin="8,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="58"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="78"/>
                                        <ColumnDefinition Width="62"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Codigo" VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="Produto" VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="2" Text="Qtd" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource Muted}" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="3" Text="Total" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="4" Text="Acao" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" FontWeight="SemiBold"/>
                                </Grid>
                            </Border>
                            <ListBox Grid.Row="1"
                                     x:Name="TicketList"
                                     ItemsSource="{Binding TicketLines}"
                                     ItemTemplate="{StaticResource TicketLineTemplate}"
                                     SelectionMode="Single"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     HorizontalContentAlignment="Stretch"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="4" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Margin="0,10,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="28"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Background="#F3F6F8" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                                <TextBlock Text="Pagamentos antecipados / saldo" Foreground="{StaticResource Muted}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0"/>
                            </Border>
                            <ListBox Grid.Row="1" x:Name="PaymentsList" ItemsSource="{Binding Payments}" DisplayMemberPath="Display"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="5" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Bottom">
                            <TextBlock x:Name="OpenInfoText"
                                       Text="Caixa aberto  |  Comanda ativa"
                                       Foreground="#A11D1D"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="F5 fecha conta  |  F8 antecipado  |  F9 recebe pagamento"
                                       Foreground="{StaticResource Muted}"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <TextBlock Text="Total da comanda" Foreground="{StaticResource Muted}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            <TextBlock x:Name="TicketTotalText" Text="R$ 0,00" Foreground="#A11D1D" FontSize="32" FontWeight="Bold" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource PanelCard}" Margin="0,0,10,0">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Background="#FBFDFF" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" CornerRadius="7,7,0,0">
                        <Grid Margin="12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="{StaticResource Blue}" CornerRadius="2" Height="22" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" x:Name="BoardTitleText" Text="Comandas / Mesas" Foreground="{StaticResource Ink}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            <Button Grid.Column="2"
                                    x:Name="CreateTablesButton"
                                    Content="Criar mesas"
                                    Click="CreateTables_Click"
                                    Style="{StaticResource GhostButton}"
                                    Height="30"
                                    Padding="12,0"
                                    Margin="10,0,0,0"/>
                        </Grid>
                    </Border>
                    <ListBox Grid.Row="1" x:Name="TablesList" ItemsSource="{Binding BoardTiles}" ItemTemplate="{StaticResource TableTemplate}" SelectionChanged="TablesList_SelectionChanged" MouseDoubleClick="TablesList_MouseDoubleClick" Margin="0,10,0,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource PanelCard}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44"/>
                        <RowDefinition Height="56"/>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="60"/>
                    </Grid.RowDefinitions>

                    <Border Background="#FBFDFF" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" CornerRadius="7,7,0,0">
                        <Grid Margin="12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="{StaticResource Blue}" CornerRadius="2" Height="22" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Venda rapida" Foreground="{StaticResource Ink}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="1" x:Name="CategoriesList" ItemsSource="{Binding Categories}" ItemTemplate="{StaticResource CategoryTemplate}" SelectionChanged="CategoriesList_SelectionChanged" Visibility="Collapsed" Height="0">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>

                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="112"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" Margin="0,0,8,0" FontSize="16" Height="40" VerticalContentAlignment="Center" ToolTip="Digite codigo ou nome do produto"/>
                        <Button Grid.Column="1" x:Name="SearchButton" Content="F3 Catalogo" Click="SearchButton_Click" Style="{StaticResource GhostButton}" Height="40"/>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="86"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="112"/>
                            <ColumnDefinition Width="92"/>
                            <ColumnDefinition Width="86"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Codigo" Foreground="{StaticResource Muted}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <TextBlock Grid.Column="1" Text="Produto" Foreground="{StaticResource Muted}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="Grupo" Foreground="{StaticResource Muted}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="Preco" Foreground="{StaticResource Muted}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <TextBlock Grid.Column="4" Text="Estoque" Foreground="{StaticResource Muted}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    </Grid>

                    <ListBox Grid.Row="3" x:Name="ProductsList" ItemsSource="{Binding VisibleProducts}" ItemTemplate="{StaticResource ProductTemplate}" SelectionChanged="ProductsList_SelectionChanged" MouseDoubleClick="ProductsList_MouseDoubleClick" Margin="0,0,0,4" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>

                    <Grid Grid.Row="4" Margin="0,6,0,0">
                        <Border Background="#F8FAFB" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="12,8">
                            <StackPanel>
                                <TextBlock Text="Selecionado" Foreground="{StaticResource Muted}" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock x:Name="SelectedProductText" Text="Nenhum produto selecionado" Foreground="{StaticResource Ink}" FontSize="13" FontWeight="SemiBold" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="4" Background="#FFFFFF" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <Grid Margin="10,0">
                <TextBlock x:Name="StatusText" Text="Pronto" Foreground="{StaticResource Ink}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock x:Name="KeyboardText" Text="Tab troca area: Comanda > Mesas/Fichas > Venda rapida  |  Enter inclui  |  F3 catalogo  |  Excluir na linha do item  |  F10 abrir/fechar caixa" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Border x:Name="ToastHost"
                Grid.RowSpan="5"
                Panel.ZIndex="50"
                Width="390"
                Background="#FFFFFF"
                BorderBrush="#BFD8EF"
                BorderThickness="1"
                CornerRadius="8"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,18,48"
                Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.18" Color="#000000"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="7"/>
                    <ColumnDefinition Width="54"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="ToastAccent" Background="{StaticResource Accent}" CornerRadius="8,0,0,8"/>
                <Border Grid.Column="1"
                        Width="34"
                        Height="34"
                        Background="#E8F7F4"
                        CornerRadius="7"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="ToastCodeText"
                               Text="OK"
                               Foreground="{StaticResource Accent}"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="2" Margin="0,12,14,12">
                    <TextBlock x:Name="ToastTitleText"
                               Text="Concluido"
                               Foreground="{StaticResource Ink}"
                               FontWeight="Bold"
                               FontSize="14"/>
                    <TextBlock x:Name="ToastMessageText"
                               Text="Operacao realizada."
                               Foreground="{StaticResource Muted}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
