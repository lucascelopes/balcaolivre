<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>BalcaoLivrePDVOnline</AssemblyName>
    <RootNamespace>BalcaoLivre.Online.Windows</RootNamespace>
    <Product>Balcão Livre PDV Online</Product>
    <AssemblyTitle>Balcão Livre PDV Online</AssemblyTitle>
    <Company>Nagazaki Software</Company>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>1.8.2026.29</Version>
    <AssemblyVersion>1.8.2026.29</AssemblyVersion>
    <FileVersion>1.8.2026.29</FileVersion>
    <InformationalVersion>1.8.2026.29</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="obj\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\app.ico" />
    <Resource Include="Assets\app.ico" />
    <Content Include="Assets\setup-logo.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\ifood-order-alert.mp3">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="PlugPag\x64\BTSerial.dll" Condition="Exists('PlugPag\x64\BTSerial.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>BTSerial.dll</Link>
    </Content>
    <Content Include="PlugPag\x64\PlugPag.dll" Condition="Exists('PlugPag\x64\PlugPag.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>PlugPag.dll</Link>
    </Content>
    <Content Include="PlugPag\x64\PPPagSeguro.dll" Condition="Exists('PlugPag\x64\PPPagSeguro.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>PPPagSeguro.dll</Link>
    </Content>
    <Content Include="..\BalcaoLivre.WhatsAppExtension\**\*">
      <Link>BalcaoLivre.WhatsAppExtension\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\deploy\evolution-local-windows\.dockerignore" Condition="Exists('..\deploy\evolution-local-windows\.dockerignore')">
      <Link>evolution-local-windows\.dockerignore</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\deploy\evolution-local-windows\.env.example" Condition="Exists('..\deploy\evolution-local-windows\.env.example')">
      <Link>evolution-local-windows\.env.example</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\deploy\evolution-local-windows\Dockerfile.evolution-local" Condition="Exists('..\deploy\evolution-local-windows\Dockerfile.evolution-local')">
      <Link>evolution-local-windows\Dockerfile.evolution-local</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\deploy\evolution-local-windows\docker-compose.yml" Condition="Exists('..\deploy\evolution-local-windows\docker-compose.yml')">
      <Link>evolution-local-windows\docker-compose.yml</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\deploy\evolution-local-windows\patch-baileys-version.js" Condition="Exists('..\deploy\evolution-local-windows\patch-baileys-version.js')">
      <Link>evolution-local-windows\patch-baileys-version.js</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\deploy\evolution-local-windows\README.md" Condition="Exists('..\deploy\evolution-local-windows\README.md')">
      <Link>evolution-local-windows\README.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\deploy\evolution-local-windows\start-local.ps1" Condition="Exists('..\deploy\evolution-local-windows\start-local.ps1')">
      <Link>evolution-local-windows\start-local.ps1</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\deploy\evolution-local-windows\start-bot.ps1" Condition="Exists('..\deploy\evolution-local-windows\start-bot.ps1')">
      <Link>evolution-local-windows\start-bot.ps1</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\deploy\evolution-local-windows\bot-server.mjs" Condition="Exists('..\deploy\evolution-local-windows\bot-server.mjs')">
      <Link>evolution-local-windows\bot-server.mjs</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\deploy\evolution-local-windows\stop-local.ps1" Condition="Exists('..\deploy\evolution-local-windows\stop-local.ps1')">
      <Link>evolution-local-windows\stop-local.ps1</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\deploy\evolution-local-windows\start-quick-tunnel.ps1" Condition="Exists('..\deploy\evolution-local-windows\start-quick-tunnel.ps1')">
      <Link>evolution-local-windows\start-quick-tunnel.ps1</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\deploy\evolution-local-windows\test-api.ps1" Condition="Exists('..\deploy\evolution-local-windows\test-api.ps1')">
      <Link>evolution-local-windows\test-api.ps1</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3967.48" />
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="Unimake.DFe" Version="20260529.1655.12" />
  </ItemGroup>

</Project>
