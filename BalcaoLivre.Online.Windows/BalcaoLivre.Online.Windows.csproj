<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>BalcaoLivrePDVOnline</AssemblyName>
    <RootNamespace>BalcaoLivre.Online.Windows</RootNamespace>
    <Product>Balcão Livre PDV Online</Product>
    <AssemblyTitle>Balcão Livre PDV Online</AssemblyTitle>
    <Company>Nagazaki Software</Company>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>1.8.2026.1</Version>
    <AssemblyVersion>1.8.2026.1</AssemblyVersion>
    <FileVersion>1.8.2026.1</FileVersion>
    <InformationalVersion>1.8.2026.1</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="obj\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\app.ico" />
    <Resource Include="Assets\app.ico" />
    <Content Include="Assets\setup-logo.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\ifood-order-alert.mp3">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="PlugPag\x64\BTSerial.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>BTSerial.dll</Link>
    </Content>
    <Content Include="PlugPag\x64\PlugPag.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>PlugPag.dll</Link>
    </Content>
    <Content Include="PlugPag\x64\PPPagSeguro.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>PPPagSeguro.dll</Link>
    </Content>
    <Content Include="..\BalcaoLivre.WhatsAppExtension\**\*">
      <Link>BalcaoLivre.WhatsAppExtension\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3967.48" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

</Project>
