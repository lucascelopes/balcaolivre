<Window x:Class="AgendaLivre.Windows.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Agenda Livre — Acessar conta"
        Width="1200"
        Height="700"
        MinWidth="980"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#FFFCFA"
        FontFamily="Segoe UI"
        FontWeight="Medium"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="BrandOrangeBrush" Color="#F45A16"/>
        <SolidColorBrush x:Key="FieldBorderBrush" Color="#CFC8C3"/>
        <SolidColorBrush x:Key="FieldTextBrush" Color="#1F2937"/>

        <Style x:Key="ModeButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ModeSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ModeSurface" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ModeSurface" Property="Opacity" Value="0.52"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AuthTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource FieldTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource FieldBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CaretBrush" Value="{StaticResource BrandOrangeBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="FieldSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FieldSurface" Property="BorderBrush" Value="{StaticResource BrandOrangeBrush}"/>
                                <Setter TargetName="FieldSurface" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="FieldSurface" Property="Background" Value="#F6F2EF"/>
                                <Setter TargetName="FieldSurface" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AuthPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource FieldTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource FieldBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,0,44,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CaretBrush" Value="{StaticResource BrandOrangeBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="FieldSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FieldSurface" Property="BorderBrush" Value="{StaticResource BrandOrangeBrush}"/>
                                <Setter TargetName="FieldSurface" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="FieldSurface" Property="Background" Value="#F6F2EF"/>
                                <Setter TargetName="FieldSurface" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RevealButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#5E5955"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="RevealSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RevealSurface" Property="Background" Value="#F3ECE7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="RevealSurface" Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryAuthButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="{StaticResource BrandOrangeBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PrimarySurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PrimarySurface" Property="Background" Value="#E94E0C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PrimarySurface" Property="Background" Value="#D94307"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PrimarySurface" Property="Background" Value="#E8B49D"/>
                                <Setter TargetName="PrimarySurface" Property="Opacity" Value="0.78"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#211F1D"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border x:Name="CustomTitleBar"
                Grid.Row="0"
                Panel.ZIndex="1000"
                Background="#FFF5F1"
                BorderBrush="#E1D1C9"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="CustomTitleBar_MouseLeftButtonDown">
            <Border.Resources>
                <Style x:Key="LoginWindowCaptionButton" TargetType="Button">
                    <Setter Property="Width" Value="46"/>
                    <Setter Property="Height" Value="31"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#4B413C"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="CaptionSurface" Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="CaptionSurface" Property="Background" Value="#F6E8E2"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="CaptionSurface" Property="Background" Value="#EFD8CF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <Style x:Key="LoginWindowCloseButton" TargetType="Button">
                    <Setter Property="Width" Value="46"/>
                    <Setter Property="Height" Value="31"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#4B413C"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="CloseSurface" Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="CloseSurface" Property="Background" Value="#F7DFDF"/>
                                        <Setter Property="Foreground" Value="#B4232C"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="CloseSurface" Property="Background" Value="#EDC8C9"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Border.Resources>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Margin="10,0,0,0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False">
                    <Border Width="27" Height="18" Margin="0,0,7,0">
                        <Border.Background>
                            <ImageBrush ImageSource="Assets/agenda-livre-logo-source.png"
                                        Stretch="Uniform"
                                        Viewbox="328,194,1021,543"
                                        ViewboxUnits="Absolute"/>
                        </Border.Background>
                    </Border>
                    <TextBlock Text="Agenda Livre"
                               Foreground="#352D29"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource LoginWindowCaptionButton}"
                            Click="CustomMinimizeButton_Click"
                            AutomationProperties.Name="Minimizar janela">
                        <materialDesign:PackIcon Kind="WindowMinimize" Width="13" Height="13"/>
                    </Button>
                    <Button x:Name="CustomMaximizeButton"
                            Style="{StaticResource LoginWindowCaptionButton}"
                            Click="CustomMaximizeButton_Click"
                            AutomationProperties.Name="Maximizar janela">
                        <materialDesign:PackIcon x:Name="CustomMaximizeIcon"
                                                 Kind="WindowMaximize"
                                                 Width="12"
                                                 Height="12"/>
                    </Button>
                    <Button Style="{StaticResource LoginWindowCloseButton}"
                            Click="CustomCloseButton_Click"
                            AutomationProperties.Name="Fechar janela">
                        <materialDesign:PackIcon Kind="Close" Width="15" Height="15"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.92*"/>
                <ColumnDefinition Width="1.08*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#FFF7F2"
                    Padding="38,26,32,28"
                    ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Image Source="Assets/agenda-livre-logo-light-transparent.png"
                           Width="135"
                           Height="108"
                           Margin="12,5,0,0"
                           Stretch="Fill"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           AutomationProperties.Name="Agenda Livre — Sistema de Agendamentos"/>

                    <Image x:Name="LoginStoryIllustration"
                           Grid.Row="1"
                           Source="Assets/login-secure-sync-illustration.png"
                           Stretch="Uniform"
                           MaxWidth="520"
                           MaxHeight="315"
                           Margin="4,10,4,4"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           AutomationProperties.Name="Conta protegida e sincronizada no Windows">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="1.12"/>
                                <TranslateTransform Y="-24"/>
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>

                    <TextBlock Grid.Row="2"
                               Text="Sua agenda em todos os lugares"
                               Foreground="#152238"
                               FontSize="30"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               LineHeight="38"
                               Margin="6,8,0,86"/>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="White" Padding="46,24,46,64">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel x:Name="AuthFormPanel" MaxWidth="420" VerticalAlignment="Center">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="AuthFormOffset" Y="30"/>
                        </StackPanel.RenderTransform>
                <TextBlock x:Name="TitleText"
                           Text="Bem-vindo de volta"
                           Foreground="#152238"
                           FontSize="30"
                           FontWeight="Bold"/>
                <TextBlock x:Name="SubtitleText"
                           Text="Entre para abrir sua agenda sincronizada."
                           Foreground="#6F6B68"
                           FontSize="14"
                           TextWrapping="Wrap"
                           Margin="0,6,0,18"/>

                <Border Background="#F8F7F6"
                        BorderBrush="#CFC8C3"
                        BorderThickness="1.2"
                        CornerRadius="11"
                        Padding="3"
                        Margin="0,0,0,18">
                    <Grid Height="44">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="LoginModeButton"
                                Grid.Column="0"
                                Content="Entrar"
                                Click="LoginModeButton_Click"
                                Background="#FFF4ED"
                                Foreground="#D94D0B"
                                BorderBrush="#F45A16"
                                BorderThickness="1"
                                Style="{StaticResource ModeButtonStyle}"/>
                        <Button x:Name="SignUpModeButton"
                                Grid.Column="1"
                                Content="Criar conta"
                                Click="SignUpModeButton_Click"
                                Background="Transparent"
                                Foreground="#4F4B48"
                                BorderBrush="Transparent"
                                Style="{StaticResource ModeButtonStyle}"/>
                    </Grid>
                </Border>

                <StackPanel x:Name="SignUpFieldsPanel" Visibility="Collapsed">
                    <TextBlock Text="Nome completo" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox x:Name="FullNameTextBox"
                             Margin="0,6,0,12"
                             AutomationProperties.Name="Nome completo"
                             Style="{StaticResource AuthTextBoxStyle}"/>
                    <TextBlock Text="Nome do negócio" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox x:Name="BusinessNameTextBox"
                             Margin="0,6,0,12"
                             AutomationProperties.Name="Nome do negócio"
                             Style="{StaticResource AuthTextBoxStyle}"/>
                </StackPanel>

                <TextBlock Text="E-mail" Style="{StaticResource FieldLabelStyle}"/>
                <TextBox x:Name="EmailTextBox"
                         Margin="0,6,0,12"
                         AutomationProperties.Name="E-mail"
                         Style="{StaticResource AuthTextBoxStyle}"/>

                <TextBlock Text="Senha" Style="{StaticResource FieldLabelStyle}"/>
                <Grid Margin="0,6,0,0">
                    <PasswordBox x:Name="PasswordInput"
                                 AutomationProperties.Name="Senha"
                                 Style="{StaticResource AuthPasswordBoxStyle}"/>
                    <TextBox x:Name="PasswordRevealTextBox"
                             Visibility="Collapsed"
                             Padding="12,0,44,0"
                             AutomationProperties.Name="Senha visível"
                             Style="{StaticResource AuthTextBoxStyle}"/>
                    <ToggleButton x:Name="PasswordRevealButton"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Margin="0,0,4,0"
                                  Click="PasswordRevealButton_Click"
                                  AutomationProperties.Name="Mostrar ou ocultar senha"
                                  Style="{StaticResource RevealButtonStyle}">
                        <materialDesign:PackIcon x:Name="PasswordRevealIcon"
                                                 Kind="EyeOutline"
                                                 Width="18"
                                                 Height="18"/>
                    </ToggleButton>
                </Grid>
                <TextBlock x:Name="PasswordHelpText"
                           Text="Use a senha da sua conta."
                           Foreground="#817871"
                           FontSize="11.5"
                           Margin="0,4,0,12"/>

                <Border x:Name="FeedbackBorder"
                        Background="#FFF1E9"
                        BorderBrush="#F7C7AA"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="11,9"
                        Margin="0,0,0,12"
                        Visibility="Collapsed">
                    <TextBlock x:Name="FeedbackText"
                               Foreground="#8F3B13"
                               FontSize="12"
                               TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Assertive"/>
                </Border>

                <Button x:Name="PrimaryButton"
                        Content="Entrar"
                        Click="PrimaryButton_Click"
                        IsDefault="True"
                        Style="{StaticResource PrimaryAuthButtonStyle}"/>
                <TextBlock x:Name="PrivacyText"
                           Text="Sua sessão fica protegida pela conta do Windows neste computador."
                           Foreground="#817871"
                           FontSize="11.5"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="12,14,12,0"/>
                <TextBlock x:Name="SignUpPrivacyText"
                           Foreground="#817871"
                           FontSize="11.5"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="12,14,12,0"
                           Visibility="Collapsed">
                    <Run Text="Ao criar sua conta, você concorda com o armazenamento seguro dos seus dados conforme nossa "/>
                    <Hyperlink NavigateUri="https://minhaagendalivre.com.br/agenda-livre/privacidade"
                               RequestNavigate="PrivacyLink_RequestNavigate"
                               Foreground="{StaticResource BrandOrangeBrush}">política de privacidade.</Hyperlink>
                </TextBlock>
                    </StackPanel>

                    <Grid x:Name="LoginBenefitsPanel"
                          Grid.Row="1"
                          MaxWidth="640"
                          Margin="0,18,0,0"
                          HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="ShieldAccountOutline"
                                                     Width="19" Height="19"
                                                     Foreground="{StaticResource BrandOrangeBrush}"
                                                     VerticalAlignment="Center"/>
                            <TextBlock Text="Dados separados por conta"
                                       Foreground="#384152"
                                       FontSize="10.5"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Margin="7,0,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="1" Height="24" Background="#E1DDDA" Margin="10,0"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="LockOutline"
                                                     Width="19" Height="19"
                                                     Foreground="{StaticResource BrandOrangeBrush}"
                                                     VerticalAlignment="Center"/>
                            <TextBlock Text="Sincronização protegida"
                                       Foreground="#384152"
                                       FontSize="10.5"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Margin="7,0,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="3" Width="1" Height="24" Background="#E1DDDA" Margin="10,0"/>
                        <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="CloudCheckOutline"
                                                     Width="19" Height="19"
                                                     Foreground="{StaticResource BrandOrangeBrush}"
                                                     VerticalAlignment="Center"/>
                            <TextBlock Text="Trabalho offline preservado"
                                       Foreground="#384152"
                                       FontSize="10.5"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Margin="7,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
