<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>AgendaLivreWindows</AssemblyName>
    <RootNamespace>AgendaLivre.Windows</RootNamespace>
    <Product>Agenda Livre</Product>
    <AssemblyTitle>Agenda Livre</AssemblyTitle>
    <Company>Nagazaki Software</Company>
    <Version>1.0.2026.1</Version>
    <AssemblyVersion>1.0.2026.1</AssemblyVersion>
    <FileVersion>1.0.2026.1</FileVersion>
    <InformationalVersion>1.0.2026.1</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <DefaultItemExcludes>$(DefaultItemExcludes);artifacts\**;obj\**;bin\**;AgendaLivre.Windows\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MaterialDesignThemes" Version="5.3.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
    <PackageReference Include="PDFsharp-WPF" Version="6.2.4" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="artifacts\**\*.cs" />
    <Compile Remove="SendReliabilityHarness\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\agenda-livre-logo-source.png" />
    <Resource Include="Assets\agenda-livre-logo-light-transparent.png" />
    <Resource Include="Assets\agenda-livre-logo-dark-transparent.png" />
    <Resource Include="Assets\agenda-livre-mark.png" />
    <Resource Include="Assets\login-secure-sync-illustration.png" />
    <Resource Include="Assets\appointment-payment-left-panel.png" />
    <Resource Include="Assets\marketing-story-background.png" />
    <Resource Include="Assets\marketing-campaign-hair.png" />
    <Resource Include="Assets\marketing-campaign-nails.png" />
    <Resource Include="Assets\marketing-campaign-spa.png" />
    <Resource Include="Assets\marketing-editorial-nails-nude.png" />
    <Resource Include="Assets\marketing-editorial-nails-french.png" />
    <Resource Include="Assets\marketing-editorial-nails-terracotta.png" />
    <Resource Include="Assets\marketing-editorial-nails-service.png" />
    <Resource Include="Assets\marketing-site-hero-hair.png" />
    <Resource Include="Assets\marketing-site-overview-makeup.png" />
    <Resource Include="Assets\mercado-pago-gertec-mp35p.png" />
    <Resource Include="Assets\mercado-pago-ingenico-move2500.png" />
    <Resource Include="Assets\mercado-pago-newland-n950.png" />
    <Resource Include="Assets\mercado-pago-pax-a910.png" />
    <Resource Include="Assets\mercado-pago-pax-q92.png" />
    <Resource Include="Assets\onboarding-*.png" />
    <Resource Include="Assets\Themes\*.png" />
  </ItemGroup>

</Project>
