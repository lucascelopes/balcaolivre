                                    <Button Tag="1 profissional" Content="1 profissional" Style="{StaticResource WizardOptionButton}" Margin="14,0,14,16" Click="ProfessionalCountButton_Click"/>
                                    <Button Tag="2 profissionais" Content="2 profissionais" Style="{StaticResource WizardOptionButton}" Margin="14,0,14,16" Click="ProfessionalCountButton_Click"/>
                                    <Button Tag="3 a 4 profissionais" Content="3 a 4 profissionais" Style="{StaticResource WizardOptionButton}" Margin="14,0,14,16" Click="ProfessionalCountButton_Click"/>
                                    <Button Tag="5 a 10 profissionais" Content="5 a 10 profissionais" Style="{StaticResource WizardOptionButton}" Margin="14,0,14,0" Click="ProfessionalCountButton_Click"/>
                                    <Button Tag="11 a 30 profissionais" Content="11 a 30 profissionais" Style="{StaticResource WizardOptionButton}" Margin="14,0,14,0" Click="ProfessionalCountButton_Click"/>
                                    <Button Tag="Mais de 30 profissionais" Content="Mais de 30 profissionais" Style="{StaticResource WizardOptionButton}" Margin="14,0,14,0" Click="ProfessionalCountButton_Click"/>
                                </UniformGrid>
                                </StackPanel>
                                <Button x:Name="ContinueProfessionalCountButton"
                                        Grid.Row="2"
                                        Content="Continuar"
                                        Style="{StaticResource WizardPrimaryButton}"
                                        HorizontalAlignment="Center"
                                        Click="ContinueProfessionalCountButton_Click"/>
                            </Grid>
                        </Grid>

                        <Grid x:Name="ObjectiveStepPanel" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Selecione seu principal objetivo para o sucesso"
                                       Foreground="{StaticResource Ink}"
                                       FontSize="23"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Margin="0,6,0,26"/>
                            <ScrollViewer Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Padding="0,0,8,0"
                                          Margin="0,0,0,12">
                                <UniformGrid Columns="2" HorizontalAlignment="Center">
                                    <Button Tag="Divulgar serviços" Style="{StaticResource WizardObjectiveButton}" Margin="8,0,8,16" Click="ObjectiveButton_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="☰" FontFamily="Segoe UI Symbol" FontSize="24" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="34"/>
                                            <TextBlock Text="Divulgar serviços" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Tag="Organizar agenda" Style="{StaticResource WizardObjectiveButton}" Margin="8,0,8,16" Click="ObjectiveButton_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="▣" FontFamily="Segoe UI Symbol" FontSize="23" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="34"/>
                                            <TextBlock Text="Organizar agenda" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Tag="Implementar agendamento online" Style="{StaticResource WizardObjectiveButton}" Margin="8,0,8,16" Click="ObjectiveButton_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="◷" FontFamily="Segoe UI Symbol" FontSize="24" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="34"/>
                                            <TextBlock Text="Implementar agendamento online" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Tag="Dar autonomia aos profissionais" Style="{StaticResource WizardObjectiveButton}" Margin="8,0,8,16" Click="ObjectiveButton_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="♙" FontFamily="Segoe UI Symbol" FontSize="24" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="34"/>
                                            <TextBlock Text="Dar autonomia aos profissionais" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Tag="Gerenciar a parte fiscal" Style="{StaticResource WizardObjectiveButton}" Margin="8,0,8,16" Click="ObjectiveButton_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="□" FontFamily="Segoe UI Symbol" FontSize="24" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="34"/>
                                            <TextBlock Text="Gerenciar a parte fiscal" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Tag="Facilitar pagamentos da equipe" Style="{StaticResource WizardObjectiveButton}" Margin="8,0,8,16" Click="ObjectiveButton_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="▤" FontFamily="Segoe UI Symbol" FontSize="24" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="34"/>
                                            <TextBlock Text="Facilitar pagamentos da equipe" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Tag="Administrar financeiro" Style="{StaticResource WizardObjectiveButton}" Margin="8,0,8,16" Click="ObjectiveButton_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="$" FontFamily="Segoe UI Symbol" FontSize="24" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="34"/>
                                            <TextBlock Text="Administrar financeiro" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Tag="Gerenciar agendas das unidades" Style="{StaticResource WizardObjectiveButton}" Margin="8,0,8,16" Click="ObjectiveButton_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="☷" FontFamily="Segoe UI Symbol" FontSize="24" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="34"/>
                                            <TextBlock Text="Gerenciar agendas das unidades" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Tag="Fidelizar clientes" Style="{StaticResource WizardObjectiveButton}" Margin="8,0,8,16" Click="ObjectiveButton_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="♡" FontFamily="Segoe UI Symbol" FontSize="24" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="34"/>
                                            <TextBlock Text="Fidelizar clientes" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Tag="Acompanhar todas as unidades" Style="{StaticResource WizardObjectiveButton}" Margin="8,0,8,16" Click="ObjectiveButton_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⌕" FontFamily="Segoe UI Symbol" FontSize="24" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="34"/>
                                            <TextBlock Text="Acompanhar todas as unidades" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </UniformGrid>
                            </ScrollViewer>
                            <Button x:Name="ContinueObjectiveButton"
                                    Grid.Row="2"
                                    Content="Continuar"
                                    Style="{StaticResource WizardPrimaryButton}"
                                    HorizontalAlignment="Center"
                                    Click="ContinueObjectiveButton_Click"/>
                        </Grid>

                        <Grid x:Name="AddressStepPanel" Visibility="Collapsed">
                            <StackPanel Width="610" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="Endereço do seu negócio"
                                           Foreground="{StaticResource Ink}"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Informe seu endereço para ser encontrado facilmente pelos clientes"
                                           Foreground="#64748B"
                                           FontSize="14"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"
                                           Margin="0,14,0,28"/>
                                <TextBlock Text="CEP" Foreground="#334155" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <TextBox x:Name="OnboardingCepTextBox" Style="{StaticResource WizardInput}"/>

                                <Grid Margin="0,20,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="176"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Bairro" Foreground="#334155" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <TextBox x:Name="OnboardingNeighborhoodTextBox" Style="{StaticResource WizardInput}" Background="#EEF3F8"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Logradouro" Foreground="#334155" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <TextBox x:Name="OnboardingStreetTextBox" Style="{StaticResource WizardInput}" Background="#EEF3F8"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,20,0,34">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="176"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Número" Foreground="#334155" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <TextBox x:Name="OnboardingAddressNumberTextBox" Style="{StaticResource WizardInput}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Complemento" Foreground="#334155" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <TextBox x:Name="OnboardingAddressComplementTextBox" Style="{StaticResource WizardInput}"/>
                                    </StackPanel>
                                </Grid>

                                <Button Content="Continuar"
                                        Style="{StaticResource WizardPrimaryButton}"
                                        Click="ContinueAddressButton_Click"/>
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="PasswordStepPanel" Visibility="Collapsed">
                            <StackPanel Width="430" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="Defina sua senha"
                                           Foreground="{StaticResource Ink}"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,34"/>
                                <TextBlock Text="Senha" Foreground="#334155" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <PasswordBox x:Name="OnboardingPasswordBox" Style="{StaticResource WizardPasswordInput}"/>
                                <Button Content="Começar"
                                        Style="{StaticResource WizardPrimaryButton}"
                                        MinWidth="430"
                                        Margin="0,76,0,0"
                                        Click="FinishCreateAccountButton_Click"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
