                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="FlowActionSurface" Property="Background" Value="{DynamicResource AccentSoft}"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Opacity" Value="0.78"/>
                                                </Trigger>
