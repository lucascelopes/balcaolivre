                                                       Foreground="{DynamicResource Ink}"
                                                       FontSize="11.5"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding ServiceName}"
                                                       Foreground="{DynamicResource Muted}"
                                                       FontSize="10"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,1,0,0"/>
                                        </StackPanel>
                                        <Grid Grid.Column="3" VerticalAlignment="Center">
                                            <Border Visibility="{Binding MetaVisibility}"
                                                    Background="{Binding MetaBackground}"
                                                    CornerRadius="8"
                                                    Padding="7,5">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="ClockOutline"
                                                                             Foreground="{DynamicResource Ink}"
                                                                             Width="13"
                                                                             Height="13"
                                                                             Margin="0,0,4,0"/>
                                                    <TextBlock Text="{Binding MetaText}"
                                                               Foreground="{DynamicResource Ink}"
                                                               FontSize="10.5"
                                                               FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Border>
                                            <Button Visibility="{Binding ActionVisibility}"
                                                    Content="{Binding ActionLabel}"
                                                    Tag="{Binding AppointmentId}"
                                                    CommandParameter="{Binding ActionKind}"
                                                    Style="{StaticResource AgendaFlowActionButton}"
                                                    Foreground="{Binding ActionBrush}"
                                                    BorderBrush="{Binding ActionBrush}"
                                                    Click="AppointmentFlowActionButton_Click"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </Border.Resources>

                        <Grid Margin="15,14,15,14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <materialDesign:PackIcon Kind="SwapVertical"
                                                         Foreground="{DynamicResource AccentText}"
                                                         Width="20"
                                                         Height="20"
                                                         Margin="0,0,8,0"/>
                                <TextBlock Text="Fluxo de atendimento"
                                           Foreground="{DynamicResource Ink}"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <TabControl Grid.Row="1"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0"
                                        FocusVisualStyle="{x:Null}">
                                <TabControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1"/>
                                    </ItemsPanelTemplate>
                                </TabControl.ItemsPanel>
                                <TabControl.Resources>
                                    <Style TargetType="{x:Type TabItem}">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
                                        <Setter Property="BorderThickness" Value="0,0,1,0"/>
                                        <Setter Property="Padding" Value="5,11,5,10"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type TabItem}">
                                                    <Border x:Name="AgendaFlowTabSurface"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter ContentSource="Header"
                                                                          HorizontalAlignment="Stretch"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="AgendaFlowTabSurface" Property="Background" Value="#FAF9F7"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="AgendaFlowTabSurface" Property="Background" Value="#FAF9F7"/>
                                                            <Setter TargetName="AgendaFlowTabSurface" Property="BorderBrush" Value="{DynamicResource Ink}"/>
                                                            <Setter TargetName="AgendaFlowTabSurface" Property="BorderThickness" Value="0,0,0,3"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TabControl.Resources>
                                <TabControl.Template>
                                    <ControlTemplate TargetType="{x:Type TabControl}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <Border BorderBrush="{DynamicResource Line}"
                                                    BorderThickness="1,1,1,0"
                                                    CornerRadius="12,12,0,0"
                                                    ClipToBounds="True">
                                                <ItemsPresenter/>
                                            </Border>
                                            <Border Grid.Row="1"
                                                    BorderBrush="{DynamicResource Line}"
                                                    BorderThickness="1"
                                                    CornerRadius="0,0,12,12"
                                                    Background="#FFFFFF"
                                                    Padding="13,15">
                                                <ContentPresenter ContentSource="SelectedContent"/>
                                            </Border>
                                        </Grid>
                                    </ControlTemplate>
                                </TabControl.Template>

                                <TabItem IsSelected="True">
                                    <TabItem.Header>
                                        <StackPanel HorizontalAlignment="Center">
                                            <materialDesign:PackIcon Kind="AccountClockOutline"
                                                                     Foreground="{DynamicResource Ink}"
                                                                     Width="24"
                                                                     Height="24"
                                                                     HorizontalAlignment="Center"/>
                                            <TextBlock Text="Aguardando"
                                                       Foreground="{DynamicResource Ink}"
                                                       FontSize="10.5"
                                                       FontWeight="Bold"
                                                       Margin="0,5,0,5"
                                                       HorizontalAlignment="Center"/>
                                            <Border Background="#F5F3F1"
                                                    CornerRadius="7"
                                                    Padding="7,3"
                                                    HorizontalAlignment="Center">
                                                <TextBlock x:Name="AgendaFlowAwaitingCountText"
                                                           Text="0"
                                                           Foreground="{DynamicResource Ink}"
                                                           FontSize="10.5"
                                                           FontWeight="Bold"/>
                                            </Border>
                                        </StackPanel>
                                    </TabItem.Header>
                                    <Grid>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl x:Name="AgendaFlowAwaitingItemsControl"
                                                          ItemTemplate="{StaticResource AgendaFlowRowTemplate}"/>
                                        </ScrollViewer>
                                        <StackPanel HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasItems, ElementName=AgendaFlowAwaitingItemsControl}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Border Width="66"
                                                    Height="66"
                                                    Background="#F7F5F3"
                                                    CornerRadius="33"
                                                    HorizontalAlignment="Center">
                                                <materialDesign:PackIcon Kind="AccountClockOutline"
                                                                         Foreground="{DynamicResource Ink}"
                                                                         Width="34"
                                                                         Height="34"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Aguardando chegada"
                                                       Foreground="{DynamicResource Ink}"
                                                       FontSize="15"
                                                       FontWeight="Bold"
                                                       Margin="0,12,0,0"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="AgendaFlowAwaitingEmptyText"
                                                       Text="Nenhuma chegada aguardando."
                                                       Foreground="{DynamicResource Muted}"
                                                       FontSize="10.5"
                                                       Margin="0,6,0,0"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="Os próximos clientes aparecerão aqui."
                                                       Foreground="{DynamicResource Muted}"
                                                       FontSize="9.5"
                                                       Margin="0,4,0,0"
                                                       Opacity="0.82"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </TabItem>

                                <TabItem>
                                    <TabItem.Header>
                                        <StackPanel HorizontalAlignment="Center">
                                            <materialDesign:PackIcon Kind="ProgressClock"
                                                                     Foreground="#D97706"
                                                                     Width="24"
                                                                     Height="24"
                                                                     HorizontalAlignment="Center"/>
                                            <TextBlock Text="Atendendo"
                                                       Foreground="#B85F05"
                                                       FontSize="10.5"
                                                       FontWeight="Bold"
                                                       Margin="0,5,0,5"
                                                       HorizontalAlignment="Center"/>
                                            <Border Background="#FFF7E6"
                                                    CornerRadius="7"
                                                    Padding="7,3"
                                                    HorizontalAlignment="Center">
                                                <TextBlock x:Name="AgendaFlowInServiceCountText"
                                                           Text="0"
                                                           Foreground="#9A5A00"
                                                           FontSize="10.5"
                                                           FontWeight="Bold"/>
                                            </Border>
                                        </StackPanel>
                                    </TabItem.Header>
                                    <Grid>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl x:Name="AgendaFlowInServiceItemsControl"
                                                          ItemTemplate="{StaticResource AgendaFlowRowTemplate}"/>
                                        </ScrollViewer>
                                        <StackPanel HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasItems, ElementName=AgendaFlowInServiceItemsControl}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Border Width="66"
                                                    Height="66"
                                                    Background="#FFF7E6"
                                                    CornerRadius="33"
                                                    HorizontalAlignment="Center">
                                                <materialDesign:PackIcon Kind="ProgressClock"
                                                                         Foreground="#D97706"
                                                                         Width="34"
                                                                         Height="34"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Em atendimento"
                                                       Foreground="#B85F05"
                                                       FontSize="15"
                                                       FontWeight="Bold"
                                                       Margin="0,12,0,0"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="AgendaFlowInServiceEmptyText"
                                                       Text="Nenhum atendimento em andamento."
                                                       Foreground="{DynamicResource Muted}"
                                                       FontSize="10.5"
                                                       Margin="0,6,0,0"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="Os atendimentos iniciados aparecerão aqui."
                                                       Foreground="{DynamicResource Muted}"
                                                       FontSize="9.5"
                                                       Margin="0,4,0,0"
                                                       Opacity="0.82"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </TabItem>

                                <TabItem>
                                    <TabItem.Header>
                                        <StackPanel HorizontalAlignment="Center">
                                            <materialDesign:PackIcon Kind="CashCheck"
                                                                     Foreground="#15803D"
                                                                     Width="24"
                                                                     Height="24"
                                                                     HorizontalAlignment="Center"/>
                                            <TextBlock Text="Cobrança"
                                                       Foreground="#15803D"
                                                       FontSize="10.5"
                                                       FontWeight="Bold"
                                                       Margin="0,5,0,5"
                                                       HorizontalAlignment="Center"/>
                                            <Border Background="#EAFBF2"
                                                    CornerRadius="7"
                                                    Padding="7,3"
                                                    HorizontalAlignment="Center">
                                                <TextBlock x:Name="AgendaFlowPaymentCountText"
                                                           Text="0"
                                                           Foreground="#15803D"
                                                           FontSize="10.5"
                                                           FontWeight="Bold"/>
                                            </Border>
                                        </StackPanel>
                                    </TabItem.Header>
                                    <Grid>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl x:Name="AgendaFlowPaymentItemsControl"
                                                          ItemTemplate="{StaticResource AgendaFlowRowTemplate}"/>
                                        </ScrollViewer>
                                        <StackPanel HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasItems, ElementName=AgendaFlowPaymentItemsControl}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Border Width="66"
                                                    Height="66"
                                                    Background="#EAFBF2"
                                                    CornerRadius="33"
                                                    HorizontalAlignment="Center">
                                                <materialDesign:PackIcon Kind="CashCheck"
                                                                         Foreground="#15803D"
                                                                         Width="34"
                                                                         Height="34"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Pronto para cobrar"
                                                       Foreground="#15803D"
                                                       FontSize="15"
                                                       FontWeight="Bold"
                                                       Margin="0,12,0,0"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="AgendaFlowPaymentEmptyText"
                                                       Text="Nenhum pagamento pendente."
                                                       Foreground="{DynamicResource Muted}"
                                                       FontSize="10.5"
                                                       Margin="0,6,0,0"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="Os atendimentos concluídos aparecerão aqui."
                                                       Foreground="{DynamicResource Muted}"
                                                       FontSize="9.5"
                                                       Margin="0,4,0,0"
                                                       Opacity="0.82"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </TabItem>
                            </TabControl>

                            <Button Grid.Row="2"
                                    Content="Ver agenda completa  ›"
                                    Style="{StaticResource GhostButton}"
                                    Height="38"
                                    Margin="0,11,0,0"
                                    HorizontalAlignment="Stretch"
                                    Click="AgendaFlowViewAllButton_Click"/>
                        </Grid>
                    </Border>

                    <ListBox x:Name="ProfessionalListBox" Grid.Column="1" Visibility="Collapsed"/>
                    <ListBox x:Name="RecentCustomerListBox" Grid.Column="1" Visibility="Collapsed"/>
                    <TextBlock x:Name="DataPathText" Grid.Column="1" Visibility="Collapsed"/>
                </Grid>
                </Grid>
            </ScrollViewer>

            <Grid x:Name="PdvWorkspaceView"
                  Grid.Column="1"
                  Background="#FAF9F7"
                  Visibility="Collapsed">
                <Grid.Resources>
                    <Style x:Key="PdvActionRailButton" TargetType="Button">
                        <Setter Property="Height" Value="65"/>
                        <Setter Property="Margin" Value="7,4"/>
                        <Setter Property="Padding" Value="3"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#3B332D"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Chrome"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="10">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chrome" Property="Background" Value="#FFF1E9"/>
                                            <Setter TargetName="Chrome" Property="BorderBrush" Value="#F26722"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Chrome" Property="Opacity" Value="0.82"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Grid.Resources>
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="64"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border x:Name="PdvActiveRibbon"
                        Grid.Row="0"
                        Background="#171513"
                        Padding="18,0"
                        BorderBrush="#2B2723"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="PdvActiveCustomerText"
                                       Text="Selecione um atendimento no calendário"
                                       Foreground="White"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="PdvActiveServiceText"
                                       Text="O serviço ativo e seus controles aparecem aqui."
                                       Foreground="#BDB5AE"
                                       FontSize="10.5"
                                       Margin="0,3,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,18,0">
                            <Border Background="#2A2623" CornerRadius="10" Padding="12,7">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="TimerOutline" Foreground="#F26722" Width="18" Height="18" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="PdvActiveTimerText" Text="00:00:00" Foreground="White" FontSize="15" FontWeight="Bold" FontFamily="Consolas"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="PdvActiveStatusBadge" Background="#FFF1E9" CornerRadius="10" Padding="10,6" Margin="8,0,0,0">
                                <TextBlock x:Name="PdvActiveStatusText" Text="Aguardando" Foreground="#B34812" FontSize="10.5" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="PdvPauseRibbonButton" Style="{StaticResource GhostButton}" Height="36" MinWidth="92" Margin="0,0,8,0" Click="PdvToggleTimerButton_Click" IsEnabled="False">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon x:Name="PdvPauseRibbonIcon" Kind="Play" Width="16" Height="16" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="PdvPauseRibbonText" Text="Iniciar"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="PdvFinishRibbonButton" Style="{StaticResource CommandButton}" Height="36" MinWidth="96" Click="PdvFinishButton_Click" IsEnabled="False">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Check" Width="16" Height="16" Margin="0,0,6,0"/>
                                    <TextBlock Text="Finalizar"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Background="White" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="18,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource GhostButton}" Width="38" Height="36" Padding="0" Click="PdvPreviousDayButton_Click" ToolTip="Dia anterior">
                                <materialDesign:PackIcon Kind="ChevronLeft" Width="18" Height="18"/>
                            </Button>
                            <Button Content="Hoje" Style="{StaticResource GhostButton}" Height="36" MinWidth="68" Margin="8,0" Click="PdvTodayButton_Click"/>
                            <Button Style="{StaticResource GhostButton}" Width="38" Height="36" Padding="0" Click="PdvNextDayButton_Click" ToolTip="Próximo dia">
                                <materialDesign:PackIcon Kind="ChevronRight" Width="18" Height="18"/>
                            </Button>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="PdvDateTitleText" Text="quarta-feira, 22 de julho" Foreground="{DynamicResource Ink}" FontSize="18" FontWeight="Bold" TextAlignment="Center"/>
                            <TextBlock x:Name="PdvDateSummaryText" Text="0 atendimentos · 0 em andamento" Foreground="{DynamicResource Muted}" FontSize="10.5" TextAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="2" Background="#F5F2EF" CornerRadius="10" Padding="4" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="PdvDayButton" Content="Dia" Style="{StaticResource CommandButton}" Height="32" MinWidth="62" Click="PdvDayButton_Click"/>
                                <Button x:Name="PdvWeekButton" Content="Semana" Style="{StaticResource GhostButton}" Height="32" MinWidth="78" Margin="4,0,0,0" Click="PdvWeekButton_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Row="2" Margin="14,12,14,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="82"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Background="White"
                            BorderBrush="{DynamicResource Line}"
                            BorderThickness="1"
                            CornerRadius="16"
                            ClipToBounds="True">
                        <Grid>
                            <ScrollViewer x:Name="PdvScheduleScrollViewer"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Auto"
                                          CanContentScroll="False"
                                          PanningMode="Both"
                                          PreviewMouseLeftButtonDown="PdvScheduleScrollViewer_PreviewMouseLeftButtonDown"
                                          PreviewMouseMove="PdvScheduleScrollViewer_PreviewMouseMove"
                                          PreviewMouseLeftButtonUp="PdvScheduleScrollViewer_PreviewMouseLeftButtonUp"
                                          LostMouseCapture="PdvScheduleScrollViewer_LostMouseCapture"
                                          ScrollChanged="PdvScheduleScrollViewer_ScrollChanged">
                                <Grid x:Name="PdvScheduleBoardGrid" Background="White"/>
                            </ScrollViewer>
                            <Grid x:Name="PdvScheduleStickyHeaderGrid"
                                  Height="58"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Top"
                                  Background="#FBF7F4"
                                  IsHitTestVisible="False"
                                  Panel.ZIndex="35"/>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1"
                            Margin="8,0,0,0"
                            Background="White"
                            BorderBrush="{DynamicResource Line}"
                            BorderThickness="1"
                            CornerRadius="16">
                        <StackPanel VerticalAlignment="Top" Margin="0,5">
                            <Button x:Name="PdvDetailsRailButton" Style="{StaticResource PdvActionRailButton}" Click="PdvDetailsButton_Click" ToolTip="Detalhes do atendimento (F2)">
                                <StackPanel>
                                    <materialDesign:PackIcon Kind="AccountDetails" Width="21" Height="21" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Detalhes" FontSize="9.5" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                    <TextBlock Text="F2" Foreground="{DynamicResource Muted}" FontSize="8.5" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="PdvEditRailButton" Style="{StaticResource PdvActionRailButton}" Click="PdvEditButton_Click" ToolTip="Editar atendimento (F3)">
                                <StackPanel>
                                    <materialDesign:PackIcon Kind="PencilOutline" Width="21" Height="21" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Editar" FontSize="9.5" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                    <TextBlock Text="F3" Foreground="{DynamicResource Muted}" FontSize="8.5" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="PdvTimerRailButton" Style="{StaticResource PdvActionRailButton}" Click="PdvOpenTimerPanelButton_Click" ToolTip="Acompanhar tempo (F4)">
                                <StackPanel>
                                    <materialDesign:PackIcon Kind="TimerOutline" Width="21" Height="21" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Tempo" FontSize="9.5" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                    <TextBlock Text="F4" Foreground="{DynamicResource Muted}" FontSize="8.5" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="PdvProductsRailButton" Style="{StaticResource PdvActionRailButton}" Click="PdvProductsButton_Click" ToolTip="Produtos e serviços (F5)">
                                <StackPanel>
                                    <materialDesign:PackIcon Kind="PackageVariantClosed" Width="21" Height="21" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Produtos e&#x0a;serviços" TextAlignment="Center" FontSize="8.7" LineHeight="10" FontWeight="SemiBold" Margin="0,3,0,0"/>
                                    <TextBlock Text="F5" Foreground="{DynamicResource Muted}" FontSize="8.5" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="PdvReceiveRailButton" Style="{StaticResource PdvActionRailButton}" Click="PdvReceiveButton_Click" ToolTip="Receber pagamento (F6)">
                                <StackPanel>
                                    <materialDesign:PackIcon Kind="CashRegister" Width="21" Height="21" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Receber" FontSize="9.5" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                    <TextBlock Text="F6" Foreground="{DynamicResource Muted}" FontSize="8.5" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border x:Name="PdvInspectorCard"
                            Grid.Column="0"
                            Width="360"
                            Height="468"
                            Margin="0,0,14,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="White"
                            BorderBrush="#E6D6CC"
                            BorderThickness="1"
                            CornerRadius="18"
                            Padding="14"
                            Panel.ZIndex="50"
                            Visibility="Collapsed">
                        <Border.Effect>
                            <DropShadowEffect Color="#3A2418" BlurRadius="24" ShadowDepth="6" Opacity="0.18"/>
                        </Border.Effect>
                        <Grid>
                            <Grid Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid>
