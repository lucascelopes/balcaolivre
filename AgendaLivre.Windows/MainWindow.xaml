                            <Button Content="Ganho" Tag="won" Style="{StaticResource GhostButton}" Height="32" Margin="2,0" Click="UpdateWhatsAppLeadStageButton_Click"/>
                            <Button Content="Perdido" Tag="lost" Style="{StaticResource GhostButton}" Height="32" Margin="4,0,0,0" Click="UpdateWhatsAppLeadStageButton_Click"/>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border x:Name="WhatsAppReplyPanel"
