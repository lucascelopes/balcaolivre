                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Gastos" Foreground="{StaticResource Ink}" FontSize="18" FontWeight="Bold"/>
                                            <TextBlock Text="Despesas lancadas." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0"/>
