                                                CornerRadius="12"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="StepChrome" Property="Background" Value="{DynamicResource AccentSoft}"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="StepChrome" Property="Opacity" Value="0.78"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <Style x:Key="AppointmentModalPrimaryButtonStyle" TargetType="Button">
                            <Setter Property="Background" Value="{DynamicResource AccentDark}"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource AccentDark}"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="PrimaryChrome"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="{StaticResource AppActionRadius}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="PrimaryChrome" Property="Background" Value="{DynamicResource AccentText}"/>
                                                <Setter TargetName="PrimaryChrome" Property="BorderBrush" Value="{DynamicResource AccentText}"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="PrimaryChrome" Property="Opacity" Value="0.84"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="PrimaryChrome" Property="Opacity" Value="0.45"/>
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="PrimaryChrome" Property="BorderBrush" Value="{DynamicResource Ink}"/>
                                                <Setter TargetName="PrimaryChrome" Property="BorderThickness" Value="2"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <Style x:Key="AppointmentModalGhostButtonStyle" TargetType="Button">
                            <Setter Property="Background" Value="{DynamicResource Panel}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="GhostChrome"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="{StaticResource AppActionRadius}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="GhostChrome" Property="Background" Value="{DynamicResource AccentSoft}"/>
                                                <Setter TargetName="GhostChrome" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="GhostChrome" Property="Opacity" Value="0.78"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="GhostChrome" Property="Opacity" Value="0.45"/>
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="GhostChrome" Property="BorderBrush" Value="{DynamicResource AccentText}"/>
                                                <Setter TargetName="GhostChrome" Property="BorderThickness" Value="2"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Border.Resources>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Height="84"
                                Background="#FFFFFF"
                                BorderBrush="{DynamicResource Line}"
                                BorderThickness="0,0,0,1"
                                CornerRadius="{StaticResource AppModalTopRadius}"
                                Padding="22,0,14,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="42"
                                        Height="42"
                                        CornerRadius="{StaticResource AppBadgeLargeRadius}"
                                        Background="{DynamicResource AccentSoft}">
                                    <materialDesign:PackIcon Kind="CalendarPlus"
                                                             Foreground="{DynamicResource Accent}"
                                                             Width="20"
                                                             Height="20"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <TextBlock x:Name="EditorTitleText"
                                               Text="Novo agendamento"
                                               Foreground="{StaticResource Ink}"
                                               FontSize="21"
                                               FontWeight="SemiBold"
                                               LineHeight="27"/>
                                    <TextBlock x:Name="EditorStatusText"
                                               Text="Preencha o horário, o serviço e os dados do cliente."
                                               Foreground="{StaticResource Muted}"
                                               FontSize="12"
                                               LineHeight="17"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="2"
                                        Style="{StaticResource GhostButton}"
                                        Width="48"
                                        MinWidth="48"
                                        Height="48"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        Foreground="{DynamicResource Ink}"
                                        Click="CloseAppointmentModalButton_Click"
                                        ToolTip="Fechar"
                                        AutomationProperties.Name="Fechar agendamento">
                                    <materialDesign:PackIcon Kind="Close"
                                                             Width="20"
                                                             Height="20"
                                                             Foreground="{DynamicResource Ink}"/>
                                </Button>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1"
                                Height="68"
                                Background="#FFFFFF"
                                BorderBrush="{DynamicResource Line}"
                                BorderThickness="0,0,0,1"
                                Padding="18,8">
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Button x:Name="AppointmentStepOneButton"
                                        Style="{StaticResource AppointmentStepButtonStyle}"
                                        Tag="0"
                                        Click="AppointmentStepButton_Click"
                                        AutomationProperties.Name="Etapa 1, horário e atendimento">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border x:Name="AppointmentStepOneCircle"
                                                Width="32"
                                                Height="32"
                                                Background="{DynamicResource Accent}"
                                                BorderBrush="{DynamicResource Accent}"
                                                BorderThickness="1"
                                                CornerRadius="16">
                                            <TextBlock x:Name="AppointmentStepOneNumber"
                                                       Text="1"
                                                       Foreground="#FFFFFF"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock x:Name="AppointmentStepOneLabel"
                                                   Text="Horário"
                                                   Foreground="{DynamicResource Ink}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Margin="10,0,0,0"/>
                                    </StackPanel>
                                </Button>

                                <Border x:Name="AppointmentStepConnectorOne"
                                        Grid.Column="1"
                                        Height="2"
                                        Background="{DynamicResource Line}"
                                        CornerRadius="1"
                                        Margin="4,0"
                                        VerticalAlignment="Center"/>

                                <Button x:Name="AppointmentStepTwoButton"
                                        Grid.Column="2"
                                        Style="{StaticResource AppointmentStepButtonStyle}"
                                        Tag="1"
                                        Click="AppointmentStepButton_Click"
                                        AutomationProperties.Name="Etapa 2, cliente">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border x:Name="AppointmentStepTwoCircle"
                                                Width="32"
                                                Height="32"
                                                Background="#FFFFFF"
                                                BorderBrush="{DynamicResource Line}"
                                                BorderThickness="1"
                                                CornerRadius="16">
                                            <TextBlock x:Name="AppointmentStepTwoNumber"
                                                       Text="2"
                                                       Foreground="{DynamicResource Muted}"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock x:Name="AppointmentStepTwoLabel"
                                                   Text="Cliente"
                                                   Foreground="{DynamicResource Muted}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Margin="10,0,0,0"/>
                                    </StackPanel>
                                </Button>

                                <Border x:Name="AppointmentStepConnectorTwo"
                                        Grid.Column="3"
                                        Height="2"
                                        Background="{DynamicResource Line}"
                                        CornerRadius="1"
                                        Margin="4,0"
                                        VerticalAlignment="Center"/>

                                <Button x:Name="AppointmentStepThreeButton"
                                        Grid.Column="4"
                                        Style="{StaticResource AppointmentStepButtonStyle}"
                                        Tag="2"
                                        Click="AppointmentStepButton_Click"
                                        AutomationProperties.Name="Etapa 3, confirmar">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border x:Name="AppointmentStepThreeCircle"
                                                Width="32"
                                                Height="32"
                                                Background="#FFFFFF"
                                                BorderBrush="{DynamicResource Line}"
                                                BorderThickness="1"
                                                CornerRadius="16">
                                            <TextBlock x:Name="AppointmentStepThreeNumber"
                                                       Text="3"
                                                       Foreground="{DynamicResource Muted}"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock x:Name="AppointmentStepThreeLabel"
                                                   Text="Confirmar"
                                                   Foreground="{DynamicResource Muted}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Margin="10,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <Border x:Name="AppointmentRuleAlert"
                                Grid.Row="2"
                                Background="#FEF2F2"
                                BorderBrush="#FCA5A5"
                                BorderThickness="1"
                                CornerRadius="{StaticResource AppActionRadius}"
                                Padding="10"
                                Margin="16,8,16,0"
                                Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="AlertCircle"
                                                         Foreground="#DC2626"
                                                         Width="17"
                                                         Height="17"
                                                         VerticalAlignment="Top"
                                                         Margin="0,2,0,0"/>
                                <TextBlock x:Name="AppointmentRuleText"
                                           Grid.Column="1"
                                           Foreground="{StaticResource Ink}"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           AutomationProperties.Name="Aviso do agendamento"
                                           AutomationProperties.LiveSetting="Assertive"
                                           TextWrapping="Wrap"/>
                            </Grid>
                        </Border>

                        <ScrollViewer x:Name="AppointmentEditorScrollViewer"
                                      Grid.Row="3"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ScrollViewer.Resources>
                                <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource AppSlimScrollBar}"/>
                            </ScrollViewer.Resources>
                            <Grid KeyboardNavigation.TabNavigation="Cycle"
                                  Margin="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <Border x:Name="AppointmentScheduleStep"
                                            Background="#FFFFFF"
                                            BorderBrush="{DynamicResource Line}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource AppSurfaceRadius}"
                                            Padding="15"
                                            Margin="0,0,0,14">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,15">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="38" Height="38" Background="{DynamicResource AccentSoft}" CornerRadius="{StaticResource AppBadgeRadius}" Margin="0,0,10,0">
                                                    <materialDesign:PackIcon Kind="ClockOutline" Foreground="{DynamicResource Accent}" Width="19" Height="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="Horário e serviço" Foreground="{StaticResource Ink}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </Grid>

                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="8"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <ComboBox x:Name="AppointmentSegmentCombo"
                                                          Visibility="Collapsed"
                                                          Style="{StaticResource AppointmentComboBox}"
                                                          IsTabStop="False"
                                                          SelectionChanged="AppointmentSegmentCombo_SelectionChanged"/>
                                                <TextBox Style="{StaticResource AppointmentInputBox}"
                                                         Text="{Binding SelectedItem, ElementName=AppointmentSegmentCombo, Mode=OneWay}"
                                                         materialDesign:HintAssist.Hint="Segmento *"
                                                         IsReadOnly="True"
                                                         IsHitTestVisible="False"
                                                         Focusable="False"
                                                         IsTabStop="False"
                                                         Cursor="Arrow"
                                                          AutomationProperties.Name="Segmento do estabelecimento"
                                                          AutomationProperties.HelpText="Definido nas configurações do estabelecimento"/>
                                                <DatePicker x:Name="AppointmentDatePicker"
                                                            Grid.Column="2"
                                                            Style="{StaticResource AppointmentDatePicker}"
                                                            SelectedDateChanged="AppointmentSummaryInput_Changed"
                                                            materialDesign:HintAssist.Hint="Data *"
                                                            AutomationProperties.Name="Data do agendamento"/>
                                                <ComboBox x:Name="TimeCombo"
                                                          Grid.Row="2"
                                                          Style="{StaticResource AppointmentComboBox}"
                                                          SelectionChanged="AppointmentSummaryInput_Changed"
                                                          materialDesign:HintAssist.Hint="Horário *"
                                                          AutomationProperties.Name="Horário do agendamento"/>
                                                <ComboBox x:Name="DurationCombo"
                                                          Grid.Row="2"
                                                          Grid.Column="2"
                                                          Style="{StaticResource AppointmentComboBox}"
                                                          SelectionChanged="AppointmentSummaryInput_Changed"
                                                          materialDesign:HintAssist.Hint="Duração *"
                                                          AutomationProperties.Name="Duração do atendimento"/>
                                            </Grid>

                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <ComboBox x:Name="ServiceCombo"
                                                          Style="{StaticResource AppointmentComboBox}"
                                                          materialDesign:HintAssist.Hint="Serviço *"
                                                          DisplayMemberPath="DisplayName"
                                                          SelectionChanged="ServiceCombo_SelectionChanged"
                                                          AutomationProperties.Name="Serviço do agendamento"/>
                                                <TextBox x:Name="PriceTextBox"
                                                         Grid.Column="2"
                                                         Style="{StaticResource AppointmentInputBox}"
                                                         TextChanged="AppointmentSummaryInput_Changed"
                                                         materialDesign:HintAssist.Hint="Valor *"
                                                         materialDesign:TextFieldAssist.PrefixText="R$ "
                                                         Tag="0,00"
                                                         AutomationProperties.Name="Valor do atendimento"/>
                                            </Grid>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="ResourceLabelText" Text="Mesa ou cadeira *" Visibility="Collapsed"/>
                                                <ComboBox x:Name="ProfessionalCombo"
                                                          Style="{StaticResource AppointmentComboBox}"
                                                          SelectionChanged="AppointmentSummaryInput_Changed"
                                                          materialDesign:HintAssist.Hint="Profissional *"
                                                          DisplayMemberPath="Name"
                                                          AutomationProperties.Name="Profissional do atendimento"/>
                                                <ComboBox x:Name="ResourceCombo"
                                                          Grid.Column="2"
                                                          Style="{StaticResource AppointmentComboBox}"
                                                          SelectionChanged="AppointmentSummaryInput_Changed"
                                                          materialDesign:HintAssist.Hint="{Binding Text, ElementName=ResourceLabelText}"
                                                          AutomationProperties.Name="Recurso do atendimento"/>
                                            </Grid>

                                            <Border Background="{DynamicResource AccentSoft}"
                                                    BorderBrush="{DynamicResource Line}"
                                                    BorderThickness="1"
                                                    CornerRadius="13"
                                                    Padding="14,10"
                                                    Margin="0,14,0,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.1*"/>
                                                        <ColumnDefinition Width="1.2*"/>
                                                        <ColumnDefinition Width="1.1*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="AppointmentSummaryDateTimeText"
                                                               Text="Data e horário ainda não definidos"
                                                               Foreground="{DynamicResource Ink}"
                                                               FontSize="11.5"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="AppointmentSummaryServiceText"
                                                               Grid.Column="1"
                                                               Text="Serviço não selecionado"
                                                               Foreground="{DynamicResource Muted}"
                                                               FontSize="11.5"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="12,0"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="AppointmentSummaryResourceText"
                                                               Grid.Column="2"
                                                               Text="Profissional e recurso"
                                                               Foreground="{DynamicResource Muted}"
                                                               FontSize="11.5"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="12,0"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="AppointmentSummaryPriceText"
                                                               Grid.Column="3"
                                                               Text="R$ 0,00"
                                                               Foreground="{DynamicResource Accent}"
                                                               FontSize="14"
                                                               FontWeight="Bold"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <Border x:Name="AppointmentClientStep"
                                            Background="#FFFFFF"
                                            BorderBrush="{DynamicResource Line}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource AppSurfaceRadius}"
                                            Padding="15"
                                            Visibility="Collapsed">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,15">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="38" Height="38" Background="{DynamicResource AccentSoft}" CornerRadius="{StaticResource AppBadgeRadius}" Margin="0,0,10,0">
                                                    <materialDesign:PackIcon Kind="AccountOutline" Foreground="{DynamicResource Accent}" Width="19" Height="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock x:Name="ClientSectionTitle" Grid.Column="1" Text="Cliente" Foreground="{StaticResource Ink}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <Button Grid.Column="2" Content="Cadastrar" Visibility="Collapsed" Style="{StaticResource GhostButton}" Height="28" MinWidth="84" Padding="9,0" FontSize="11.5" Click="NewCustomerQuickButton_Click" AutomationProperties.Name="Cadastrar cliente"/>
                                            </Grid>

                                            <Border Background="{DynamicResource Ink}"
                                                    CornerRadius="14"
                                                    Padding="16,12"
                                                    Margin="0,0,0,14">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock x:Name="AppointmentClientContextTitle"
                                                                   Text="Serviço selecionado"
                                                                   Foreground="#FFFFFF"
                                                                   FontSize="14"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock x:Name="AppointmentClientContextDetail"
                                                                   Text="Data, horário, profissional e recurso"
                                                                   Foreground="#FFFFFF"
                                                                   Opacity="0.68"
                                                                   FontSize="11.5"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="0,3,12,0"/>
                                                    </StackPanel>
                                                    <TextBlock x:Name="AppointmentClientContextPrice"
                                                               Grid.Column="1"
                                                               Text="R$ 0,00"
                                                               Foreground="{DynamicResource Accent}"
                                                               FontSize="18"
                                                               FontWeight="Bold"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>

                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="CustomerNameTextBox"
                                                         Style="{StaticResource AppointmentInputBox}"
                                                         TextChanged="AppointmentSummaryInput_Changed"
                                                         materialDesign:HintAssist.Hint="Cliente *"
                                                         Tag="Nome do cliente"
                                                         AutomationProperties.Name="Nome do cliente"/>
                                                <TextBox x:Name="PhoneTextBox"
                                                         Grid.Column="2"
                                                         Style="{StaticResource AppointmentInputBox}"
                                                         materialDesign:HintAssist.Hint="Telefone / WhatsApp"
                                                         Tag="Telefone"
                                                         TextChanged="PhoneTextBox_TextChanged"
                                                         LostFocus="PhoneTextBox_LostFocus"
                                                         AutomationProperties.Name="Telefone do cliente"/>
                                            </Grid>

                                            <TextBlock x:Name="ProfileLabelText" Text="Preferência ou observação" Visibility="Collapsed"/>
                                            <TextBox x:Name="CustomerProfileTextBox"
                                                     Style="{StaticResource AppointmentInputBox}"
                                                     materialDesign:HintAssist.Hint="{Binding Text, ElementName=ProfileLabelText}"
                                                     Tag="Detalhe do atendimento"
                                                     Margin="0,0,0,12"
                                                     AutomationProperties.Name="Preferência ou detalhe do cliente"/>
                                            <TextBox x:Name="NotesTextBox"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     VerticalContentAlignment="Top"
                                                     Style="{StaticResource AppointmentMessageBox}"
                                                     materialDesign:HintAssist.Hint="Observações"
                                                     Tag="Observações internas do atendimento"
                                                     AutomationProperties.Name="Observações do atendimento"/>
                                        </StackPanel>
                                    </Border>

                                    <Border x:Name="AppointmentConfirmStep"
                                            Background="#FFFFFF"
                                            BorderBrush="{DynamicResource Line}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource AppSurfaceRadius}"
                                            Padding="18"
                                            Visibility="Collapsed">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="40" Height="40" Background="{DynamicResource AccentSoft}" CornerRadius="13" Margin="0,0,11,0">
                                                    <materialDesign:PackIcon Kind="CheckDecagramOutline" Foreground="{DynamicResource Accent}" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="Revise antes de salvar" Foreground="{DynamicResource Ink}" FontSize="18" FontWeight="SemiBold"/>
                                                    <TextBlock Text="Confira os dados principais do agendamento." Foreground="{DynamicResource Muted}" FontSize="11.5" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Grid>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.12*"/>
                                                    <ColumnDefinition Width="14"/>
                                                    <ColumnDefinition Width="0.88*"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Background="{DynamicResource Ink}" CornerRadius="16" Padding="20,17">
                                                    <StackPanel>
                                                        <TextBlock Text="AGENDAMENTO" Foreground="{DynamicResource Accent}" FontSize="10" FontWeight="Bold"/>
                                                        <TextBlock x:Name="AppointmentConfirmDateTimeText"
                                                                   Text="Data e horário ainda não definidos"
                                                                   Foreground="#FFFFFF"
                                                                   FontSize="20"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="0,10,0,0"/>
                                                        <TextBlock x:Name="AppointmentConfirmServiceText"
                                                                   Text="Serviço não selecionado"
                                                                   Foreground="#FFFFFF"
                                                                   FontSize="14"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="0,9,0,0"/>
