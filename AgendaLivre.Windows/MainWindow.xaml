                                <ItemsControl Grid.Row="1" x:Name="LegacyEstablishmentClientsItemsControl" ItemTemplate="{StaticResource EstablishmentListTemplate}" Cursor="Hand" MouseLeftButtonUp="EstablishmentClientsItemsControl_MouseLeftButtonUp"/>
