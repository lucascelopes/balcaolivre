<Window x:Class="AgendaLivre.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Agenda Livre Windows"
        Width="1500"
        Height="900"
        MinWidth="1200"
        MinHeight="730"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#F4F7FA"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        Style="{StaticResource MaterialDesignWindow}">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#15202B"/>
        <SolidColorBrush x:Key="Muted" Color="#637381"/>
        <SolidColorBrush x:Key="Line" Color="#D7E0EA"/>
        <SolidColorBrush x:Key="Panel" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Accent" Color="#0E766D"/>
        <SolidColorBrush x:Key="AccentDark" Color="#0A5B55"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#E0F4F1"/>
        <SolidColorBrush x:Key="BlueSoft" Color="#E8F1FF"/>
        <SolidColorBrush x:Key="WarmSoft" Color="#FFF0DF"/>
        <SolidColorBrush x:Key="Danger" Color="#B83A32"/>

        <Style x:Key="PanelCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.07" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CommandButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="98"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentDark}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource AccentDark}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.86"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource CommandButton}">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        </Style>

        <Style x:Key="SubtleButton" TargetType="Button" BasedOn="{StaticResource CommandButton}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="82"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="#F7FAFC"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource CommandButton}">
            <Setter Property="Background" Value="{StaticResource Danger}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Danger}"/>
        </Style>

        <Style x:Key="OnboardingFieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,12,0,5"/>
        </Style>

        <Style x:Key="OnboardingTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"/>
                                <TextBlock x:Name="Watermark"
                                           Text="{TemplateBinding Tag}"
                                           Foreground="#94A3B8"
                                           FontSize="{TemplateBinding FontSize}"
                                           Margin="{TemplateBinding Padding}"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Watermark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Background" Value="#EEF2F6"/>
                                <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OnboardingComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MaxDropDownHeight" Value="260"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Background="Transparent"
                                          BorderThickness="0">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <Border x:Name="Chrome"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="8">
                                    <Grid>
                                        <ContentPresenter x:Name="ContentSite"
                                                          Content="{TemplateBinding SelectionBoxItem}"
                                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                          Margin="{TemplateBinding Padding}"
                                                          VerticalAlignment="Center"
                                                          HorizontalAlignment="Left"
                                                          IsHitTestVisible="False"/>
                                        <Path Data="M 0 0 L 4 4 L 8 0 Z"
                                              Fill="{StaticResource Muted}"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              Margin="0,0,12,0"/>
                                    </Grid>
                                </Border>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False">
                                <Border Background="White"
                                        BorderBrush="{StaticResource Line}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer Margin="2" CanContentScroll="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Background" Value="#EEF2F6"/>
                                <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OnboardingFieldShell" TargetType="Border">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="OnboardingFieldTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <Style x:Key="OnboardingBareTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="25"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                            <TextBlock x:Name="Watermark"
                                       Text="{TemplateBinding Tag}"
                                       Foreground="#94A3B8"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="Normal"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Watermark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OnboardingBareComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="25"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MaxDropDownHeight" Value="260"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Background="Transparent"
                                          BorderThickness="0">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <Grid>
                                    <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      IsHitTestVisible="False"/>
                                    <Path Data="M 0 0 L 4 4 L 8 0 Z"
                                          Fill="{StaticResource Muted}"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Margin="0,0,2,0"/>
                                </Grid>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False">
                                <Border Background="White"
                                        BorderBrush="{StaticResource Line}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer Margin="2" CanContentScroll="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="MetricTemplate">
            <Border Background="{Binding Background}"
                    BorderBrush="{StaticResource Line}"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="10"
                    MinHeight="78"
                    Margin="0,0,8,8">
                <StackPanel>
                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Value}" Foreground="{StaticResource Ink}" FontSize="24" FontWeight="Bold" Margin="0,3,0,1"/>
                    <TextBlock Text="{Binding Hint}" Foreground="{StaticResource Muted}" FontSize="10.5" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ProfessionalTemplate">
            <Border Background="#FFFFFF" BorderBrush="#DDE6EF" BorderThickness="1" CornerRadius="7" Padding="9" Margin="0,0,0,7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource Ink}" FontWeight="SemiBold" FontSize="13.5" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SegmentLine}" Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="{Binding LoadBrush}" CornerRadius="12" Padding="8,3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding LoadText}" Foreground="{StaticResource Ink}" FontWeight="SemiBold" FontSize="11"/>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="AppointmentTemplate">
            <Border x:Name="AppointmentRoot"
                    Background="#FFFFFF"
                    BorderBrush="{Binding OutlineBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="0"
                    Margin="0,0,0,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="124"/>
                        <ColumnDefinition Width="104"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#F6F9FC" CornerRadius="8,0,0,8" Padding="10,11">
                        <StackPanel>
                            <TextBlock Text="{Binding TimeRange}" Foreground="{StaticResource Ink}" FontWeight="Bold" FontSize="14.5" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding DateText}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Width="4" Background="{Binding AccentBrush}" HorizontalAlignment="Left" Grid.ColumnSpan="2" CornerRadius="8,0,0,8"/>
                    <StackPanel Grid.Column="1" Margin="14,11,12,11">
                        <TextBlock Text="{Binding CustomerName}" Foreground="{StaticResource Ink}" FontWeight="Bold" FontSize="16" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding ServiceLine}" Foreground="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding ContextLine}" Foreground="{StaticResource Accent}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="4,11,10,11" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ProfessionalName}" Foreground="{StaticResource Ink}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding ResourceLine}" Foreground="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="0,11,11,11" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Background="{Binding StatusBackground}" CornerRadius="13" Padding="8,4" HorizontalAlignment="Right" MinWidth="84">
                            <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusForeground}" FontSize="10" FontWeight="Bold" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </Border>
                        <TextBlock Text="{Binding PriceText}" Foreground="{StaticResource Ink}" FontWeight="Bold" FontSize="13" HorizontalAlignment="Right" Margin="0,7,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                    <Setter TargetName="AppointmentRoot" Property="BorderBrush" Value="#0E766D"/>
                    <Setter TargetName="AppointmentRoot" Property="BorderThickness" Value="2"/>
                    <Setter TargetName="AppointmentRoot" Property="Background" Value="#F2FBF9"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="RecentCustomerTemplate">
            <Border Background="#FFFFFF" BorderBrush="#DDE6EF" BorderThickness="1" CornerRadius="7" Padding="9" Margin="0,0,0,7">
                <StackPanel>
                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource Ink}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="78"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0B1F3A" BorderBrush="#08213F" BorderThickness="0,0,0,1" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="292"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="44" Height="44" CornerRadius="10" Background="#FFFFFF">
                        <TextBlock Text="AL" Foreground="#0B1F3A" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0">
                        <TextBlock x:Name="AppTitleText" Text="Agenda Livre" Foreground="White" FontSize="22" FontWeight="Bold"/>
                        <TextBlock x:Name="AppSubtitleText" Text="Clínicas, petshops, oficinas e beleza" Foreground="#C8D6E5" FontSize="12"/>
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Column="1" Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="210"/>
                    </Grid.ColumnDefinitions>
                    <Grid Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBox x:Name="SearchTextBox"
                                 TextChanged="SearchTextBox_TextChanged"
                                 Padding="34,5,10,5"
                                 Background="White"
                                 Foreground="{StaticResource Ink}"
                                 BorderBrush="#D7E0EA"/>
                        <TextBlock Text="⌕" Foreground="{StaticResource Muted}" FontSize="18" Margin="11,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    </Grid>
                    <Button x:Name="SegmentFilterButton"
                            Grid.Column="1"
                            Content="Todos segmentos"
                            Style="{StaticResource GhostButton}"
                            Width="170"
                            HorizontalAlignment="Stretch"
                            Click="SegmentFilterButton_Click"
                            Margin="0,0,10,0"/>
                    <Button x:Name="DateFilterButton"
                            Grid.Column="2"
                            Content="Hoje"
                            Style="{StaticResource GhostButton}"
                            Width="180"
                            HorizontalAlignment="Stretch"
                            Click="DateFilterButton_Click"/>
                </Grid>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Config" Style="{StaticResource GhostButton}" Click="ConfigButton_Click" Margin="0,0,8,0"/>
                    <Button Content="Novo" Style="{StaticResource CommandButton}" Click="NewButton_Click" Margin="0,0,8,0"/>
                    <Button Content="Imprimir" Style="{StaticResource GhostButton}" Click="PrintButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="292"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelCard}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Operação" Foreground="{StaticResource Ink}" FontSize="20" FontWeight="Bold"/>
                        <TextBlock x:Name="SelectedDateTitleText" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>

                    <ItemsControl Grid.Row="1"
                                  x:Name="MetricsItemsControl"
                                  ItemTemplate="{StaticResource MetricTemplate}"
                                  Margin="0,14,0,2">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Equipe" Foreground="{StaticResource Ink}" FontSize="16" FontWeight="Bold" Margin="0,8,0,8"/>
                            <ListBox x:Name="ProfessionalListBox" ItemTemplate="{StaticResource ProfessionalTemplate}" MaxHeight="270"/>

                            <TextBlock Text="Clientes recentes" Foreground="{StaticResource Ink}" FontSize="16" FontWeight="Bold" Margin="0,14,0,8"/>
                            <ListBox x:Name="RecentCustomerListBox" ItemTemplate="{StaticResource RecentCustomerTemplate}"/>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="3" Background="#F7FAFC" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Banco local" Foreground="{StaticResource Ink}" FontWeight="Bold" FontSize="12"/>
                            <TextBlock x:Name="DataPathText" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="10.5" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="14,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource PanelCard}" Padding="14" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="AgendaTitleText" Text="Agenda geral" Foreground="{StaticResource Ink}" FontSize="24" FontWeight="Bold"/>
                            <TextBlock x:Name="AgendaSubtitleText" Text="Quadro do dia" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Confirmar" Style="{StaticResource SubtleButton}" Click="ConfirmButton_Click" Margin="0,0,8,0"/>
                            <Button Content="Chegou" Style="{StaticResource SubtleButton}" Click="CheckInButton_Click" Margin="0,0,8,0"/>
