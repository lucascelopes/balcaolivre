                                                     Width="14"
                                                     Height="14"
                                                     Margin="3,0,0,0"
                                                     VerticalAlignment="Center"
                                                     ToolTip="{Binding ReceiptDescription}"
                                                     AutomationProperties.Name="{Binding ReceiptDescription}"
