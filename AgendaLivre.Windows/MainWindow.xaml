                                           FontSize="14"
                                           TextWrapping="Wrap"
                                           LineHeight="20"
                                           Margin="0,10,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                <TextBlock x:Name="OnboardingSidebarProgressText"
                                           Text="Etapa 1 de 6"
                                           Foreground="#93C5FD"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,12"/>
                                <TextBlock x:Name="OnboardingSidebarTitleText"
                                           Text="Dados iniciais"
                                           Foreground="#FFFFFF"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           LineHeight="28"/>
                                <TextBlock x:Name="OnboardingSidebarCaptionText"
                                           Text="Identifique o responsável e o nome que aparecerá no sistema."
                                           Foreground="#CBD5E1"
                                           FontSize="14"
                                           TextWrapping="Wrap"
                                           LineHeight="21"
                                           Margin="0,12,0,0"/>
                            </StackPanel>

                            <Border Grid.Row="2"
                                    Background="#172033"
                                    BorderBrush="#243047"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="14">
                                <StackPanel>
                                    <TextBlock Text="Configuração rápida"
                                               Foreground="#93C5FD"
                                               FontSize="12"
                                               FontWeight="SemiBold"/>
