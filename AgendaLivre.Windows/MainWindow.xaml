                                               Foreground="#E2E8F0"
                                               FontSize="13"
                                               TextWrapping="Wrap"
                                               LineHeight="18"
                                               Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.RowSpan="2"
                            Grid.Column="1"
                            Background="#F8FAFC"
                            CornerRadius="0,18,18,0"/>

                    <Grid x:Name="OnboardingTopBar" Grid.Column="1" Margin="34,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="OnboardingBackButton"
                                Width="132"
                                Height="32"
                                Padding="0"
                                HorizontalAlignment="Left"
                                HorizontalContentAlignment="Left"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="OnboardingBackButton_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="←" Foreground="#626A73" FontSize="19" FontWeight="SemiBold" Width="22" TextAlignment="Center"/>
                                <TextBlock Text="Voltar" Foreground="#626A73" FontSize="14" FontWeight="SemiBold" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Grid.Column="1"
                                   Text="Cadastro do negócio"
                                   Foreground="#64748B"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="OnboardingProgressText"
                                   Grid.Column="2"
                                   Foreground="#64748B"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Grid.Row="1" Grid.Column="1" Margin="40,18,40,38">
                        <Grid x:Name="InitialDataStepPanel">
                            <StackPanel Width="430"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="0,0,0,0">
                                <TextBlock Text="Cadastre seu negócio"
                                           Foreground="{StaticResource Ink}"
                                           FontSize="26"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Bora dar um up"
                                           Foreground="#64748B"
                                           FontSize="16"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"
                                           Margin="0,7,0,30"/>

                                <TextBlock Text="Nome completo" Foreground="#334155" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,7"/>
                                <TextBox x:Name="InitialFullNameTextBox"
                                         Style="{StaticResource InitialDataInput}"
                                         LostFocus="InitialNameTextBox_LostFocus"/>

                                <TextBlock Text="Celular" Foreground="#334155" FontSize="14" FontWeight="SemiBold" Margin="0,22,0,7"/>
                                <TextBox x:Name="InitialPhoneTextBox"
                                         Style="{StaticResource InitialDataInput}"
                                         LostFocus="InitialPhoneTextBox_LostFocus"/>

                                <TextBlock Text="E-mail" Foreground="#334155" FontSize="14" FontWeight="SemiBold" Margin="0,22,0,7"/>
                                <TextBox x:Name="InitialEmailTextBox" Style="{StaticResource InitialDataInput}"/>

                                <TextBlock Text="Nome do negócio" Foreground="#334155" FontSize="14" FontWeight="SemiBold" Margin="0,22,0,7"/>
                                <TextBox x:Name="InitialBusinessNameTextBox"
                                         Style="{StaticResource InitialDataInput}"
                                         LostFocus="InitialNameTextBox_LostFocus"/>

                                <Button x:Name="ContinueInitialDataButton"
                                        Content="Continuar"
                                        Style="{StaticResource WizardPrimaryButton}"
                                        MinWidth="430"
                                        Margin="0,28,0,0"
                                        Click="ContinueInitialDataButton_Click"/>
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="BusinessSegmentStepPanel" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Segmento do negócio"
                                       Foreground="{StaticResource Ink}"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,30"/>
                            <UniformGrid Grid.Row="1"
                                         Columns="4"
                                         Rows="2"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Top">
                                <Button x:Name="SegmentSalonButton" Tag="Salão de Beleza" Style="{StaticResource WizardChoiceButton}" Margin="18,0,18,20" Click="BusinessTypeButton_Click">
                                    <StackPanel>
                                        <TextBlock Text="✂" FontFamily="Segoe UI Symbol" FontSize="29" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                                        <TextBlock Text="Salão de&#x0a;Beleza" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" TextAlignment="Center" FontWeight="Bold"/>
                                    </StackPanel>
                                </Button>
                                <Button Tag="Barbearia" Style="{StaticResource WizardChoiceButton}" Margin="18,0,18,20" Click="BusinessTypeButton_Click">
                                    <StackPanel>
                                        <TextBlock Text="⌁" FontFamily="Segoe UI Symbol" FontSize="30" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                                        <TextBlock Text="Barbearia" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" TextAlignment="Center" FontWeight="Bold"/>
                                    </StackPanel>
                                </Button>
                                <Button Tag="Centro de Estética" Style="{StaticResource WizardChoiceButton}" Margin="18,0,18,20" Click="BusinessTypeButton_Click">
                                    <StackPanel>
                                        <TextBlock Text="♡" FontFamily="Segoe UI Symbol" FontSize="31" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                                        <TextBlock Text="Centro de&#x0a;Estética" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" TextAlignment="Center" FontWeight="Bold"/>
                                    </StackPanel>
                                </Button>
                                <Button Tag="Podologia" Style="{StaticResource WizardChoiceButton}" Margin="18,0,18,20" Click="BusinessTypeButton_Click">
                                    <StackPanel>
                                        <TextBlock Text="⌒" FontFamily="Segoe UI Symbol" FontSize="31" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                                        <TextBlock Text="Podologia" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" TextAlignment="Center" FontWeight="Bold"/>
                                    </StackPanel>
                                </Button>
                                <Button Tag="Spa" Style="{StaticResource WizardChoiceButton}" Margin="18,0,18,20" Click="BusinessTypeButton_Click">
                                    <StackPanel>
                                        <TextBlock Text="≋" FontFamily="Segoe UI Symbol" FontSize="31" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                                        <TextBlock Text="Spa" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" TextAlignment="Center" FontWeight="Bold"/>
                                    </StackPanel>
                                </Button>
                                <Button Tag="Clínica médica" Style="{StaticResource WizardChoiceButton}" Margin="18,0,18,20" Click="BusinessTypeButton_Click">
                                    <StackPanel>
                                        <TextBlock Text="+" FontFamily="Segoe UI Symbol" FontSize="31" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                                        <TextBlock Text="Clínica&#x0a;médica" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" TextAlignment="Center" FontWeight="Bold"/>
                                    </StackPanel>
                                </Button>
                                <Button Tag="Petshop" Style="{StaticResource WizardChoiceButton}" Margin="18,0,18,20" Click="BusinessTypeButton_Click">
                                    <StackPanel>
                                        <TextBlock Text="◇" FontFamily="Segoe UI Symbol" FontSize="31" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                                        <TextBlock Text="Petshop" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" TextAlignment="Center" FontWeight="Bold"/>
                                    </StackPanel>
                                </Button>
                                <Button Tag="Oficina" Style="{StaticResource WizardChoiceButton}" Margin="18,0,18,20" Click="BusinessTypeButton_Click">
                                    <StackPanel>
                                        <TextBlock Text="⚙" FontFamily="Segoe UI Symbol" FontSize="29" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                                        <TextBlock Text="Oficina" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" TextAlignment="Center" FontWeight="Bold"/>
                                    </StackPanel>
                                </Button>
                            </UniformGrid>
                                <Button x:Name="ContinueBusinessTypeButton"
                                    Grid.Row="2"
                                    Content="Continuar"
                                    Style="{StaticResource WizardPrimaryButton}"
                                    HorizontalAlignment="Center"
                                    Margin="0,8,0,0"
                                    Click="ContinueBusinessTypeButton_Click"/>
                        </Grid>

                        <Grid x:Name="ProfessionalCountStepPanel" Visibility="Collapsed">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel HorizontalAlignment="Center" Margin="0,8,0,0">
                                <TextBlock Text="Número de profissionais que fazem"
                                           Foreground="{StaticResource Ink}"
                                           FontSize="23"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center"/>
                                <TextBlock Text="atendimento em seu negócio"
                                           Foreground="{StaticResource Ink}"
                                           FontSize="23"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center"
                                           Margin="0,7,0,38"/>
                                <UniformGrid Columns="3" Rows="2">
                                    <Button Tag="1 profissional" Content="1 profissional" Style="{StaticResource WizardOptionButton}" Margin="14,0,14,16" Click="ProfessionalCountButton_Click"/>
                                    <Button Tag="2 profissionais" Content="2 profissionais" Style="{StaticResource WizardOptionButton}" Margin="14,0,14,16" Click="ProfessionalCountButton_Click"/>
                                    <Button Tag="3 a 4 profissionais" Content="3 a 4 profissionais" Style="{StaticResource WizardOptionButton}" Margin="14,0,14,16" Click="ProfessionalCountButton_Click"/>
                                    <Button Tag="5 a 10 profissionais" Content="5 a 10 profissionais" Style="{StaticResource WizardOptionButton}" Margin="14,0,14,0" Click="ProfessionalCountButton_Click"/>
                                    <Button Tag="11 a 30 profissionais" Content="11 a 30 profissionais" Style="{StaticResource WizardOptionButton}" Margin="14,0,14,0" Click="ProfessionalCountButton_Click"/>
                                    <Button Tag="Mais de 30 profissionais" Content="Mais de 30 profissionais" Style="{StaticResource WizardOptionButton}" Margin="14,0,14,0" Click="ProfessionalCountButton_Click"/>
                                </UniformGrid>
                                </StackPanel>
                                <Button x:Name="ContinueProfessionalCountButton"
                                        Grid.Row="2"
                                        Content="Continuar"
                                        Style="{StaticResource WizardPrimaryButton}"
                                        HorizontalAlignment="Center"
                                        Click="ContinueProfessionalCountButton_Click"/>
                            </Grid>
                        </Grid>

                        <Grid x:Name="ObjectiveStepPanel" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Selecione seu principal objetivo para o sucesso"
                                       Foreground="{StaticResource Ink}"
                                       FontSize="23"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Margin="0,6,0,26"/>
                            <ScrollViewer Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Padding="0,0,8,0"
                                          Margin="0,0,0,12">
                                <UniformGrid Columns="2" HorizontalAlignment="Center">
                                    <Button Tag="Divulgar serviços" Style="{StaticResource WizardObjectiveButton}" Margin="8,0,8,16" Click="ObjectiveButton_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="☰" FontFamily="Segoe UI Symbol" FontSize="24" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="34"/>
                                            <TextBlock Text="Divulgar serviços" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Tag="Organizar agenda" Style="{StaticResource WizardObjectiveButton}" Margin="8,0,8,16" Click="ObjectiveButton_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="▣" FontFamily="Segoe UI Symbol" FontSize="23" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="34"/>
                                            <TextBlock Text="Organizar agenda" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Tag="Implementar agendamento online" Style="{StaticResource WizardObjectiveButton}" Margin="8,0,8,16" Click="ObjectiveButton_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="◷" FontFamily="Segoe UI Symbol" FontSize="24" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="34"/>
                                            <TextBlock Text="Implementar agendamento online" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Tag="Dar autonomia aos profissionais" Style="{StaticResource WizardObjectiveButton}" Margin="8,0,8,16" Click="ObjectiveButton_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="♙" FontFamily="Segoe UI Symbol" FontSize="24" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="34"/>
                                            <TextBlock Text="Dar autonomia aos profissionais" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Tag="Gerenciar a parte fiscal" Style="{StaticResource WizardObjectiveButton}" Margin="8,0,8,16" Click="ObjectiveButton_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="□" FontFamily="Segoe UI Symbol" FontSize="24" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="34"/>
                                            <TextBlock Text="Gerenciar a parte fiscal" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Tag="Facilitar pagamentos da equipe" Style="{StaticResource WizardObjectiveButton}" Margin="8,0,8,16" Click="ObjectiveButton_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="▤" FontFamily="Segoe UI Symbol" FontSize="24" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="34"/>
                                            <TextBlock Text="Facilitar pagamentos da equipe" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Tag="Administrar financeiro" Style="{StaticResource WizardObjectiveButton}" Margin="8,0,8,16" Click="ObjectiveButton_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="$" FontFamily="Segoe UI Symbol" FontSize="24" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="34"/>
                                            <TextBlock Text="Administrar financeiro" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Tag="Gerenciar agendas das unidades" Style="{StaticResource WizardObjectiveButton}" Margin="8,0,8,16" Click="ObjectiveButton_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="☷" FontFamily="Segoe UI Symbol" FontSize="24" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="34"/>
                                            <TextBlock Text="Gerenciar agendas das unidades" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Tag="Fidelizar clientes" Style="{StaticResource WizardObjectiveButton}" Margin="8,0,8,16" Click="ObjectiveButton_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="♡" FontFamily="Segoe UI Symbol" FontSize="24" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="34"/>
                                            <TextBlock Text="Fidelizar clientes" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Tag="Acompanhar todas as unidades" Style="{StaticResource WizardObjectiveButton}" Margin="8,0,8,16" Click="ObjectiveButton_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⌕" FontFamily="Segoe UI Symbol" FontSize="24" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="34"/>
                                            <TextBlock Text="Acompanhar todas as unidades" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </UniformGrid>
                            </ScrollViewer>
                            <Button x:Name="ContinueObjectiveButton"
                                    Grid.Row="2"
                                    Content="Continuar"
                                    Style="{StaticResource WizardPrimaryButton}"
                                    HorizontalAlignment="Center"
                                    Click="ContinueObjectiveButton_Click"/>
                        </Grid>

