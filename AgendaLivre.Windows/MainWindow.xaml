                                  ItemTemplate="{StaticResource MetricTemplate}"
                                  Margin="0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" Columns="4"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    </Border>

                    <ItemsControl Grid.Row="2"
                                  x:Name="EstablishmentSectionsItemsControl"
                                  ItemTemplate="{StaticResource EstablishmentSectionTemplate}"
