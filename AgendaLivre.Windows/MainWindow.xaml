                                    <TextBlock Text="Novo profissional" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Click="NewServiceFromEstablishmentButton_Click" Height="42" MinWidth="130" Padding="10,0" Margin="0,0,8,0" AutomationProperties.Name="Novo serviço">
