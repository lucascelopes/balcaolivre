                <Grid Grid.Column="1" Margin="26,0,14,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="128"/>
                    </Grid.ColumnDefinitions>
                    <Grid Margin="0,0,16,0" Height="42" VerticalAlignment="Center">
                        <Border Background="#FFFFFF"
                                BorderBrush="#E8E3DE"
                                BorderThickness="1"
                                CornerRadius="8"/>
