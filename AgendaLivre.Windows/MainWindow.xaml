                            <TextBlock Text="Conversas recentes" Foreground="{StaticResource Ink}" FontSize="13" FontWeight="Bold"/>
                            <TextBlock x:Name="WhatsAppConversationListCountText" Text="Toque em uma conversa para abrir" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Grid x:Name="WhatsAppActiveConversationHeader" Visibility="Collapsed" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="WhatsAppBackToConversationsButton"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    Background="#F8FAFC"
                                    BorderBrush="#E2E8F0"
                                    ToolTip="Voltar para conversas"
                                    Click="BackToWhatsAppConversationsButton_Click">
                                <materialDesign:PackIcon Kind="ArrowLeft"
                                                         Width="17"
                                                         Height="17"
                                                         Foreground="{StaticResource Ink}"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"/>
                            </Button>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock x:Name="WhatsAppActiveConversationTitleText" Text="Conversa" Foreground="{StaticResource Ink}" FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="WhatsAppActiveConversationPhoneText" Text="" Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                        <Button x:Name="WhatsAppFloatingConnectButton"
