                                            </Grid.ColumnDefinitions>
                                            <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource Accent}" VerticalAlignment="Top">
                                                <TextBlock Text="3" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Local, cadeira, sala ou box" Foreground="{StaticResource Muted}" FontSize="12" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="OnboardingResourceLabelText" Foreground="{StaticResource Ink}" FontWeight="Bold" FontSize="15" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border Background="White" BorderBrush="#D7E0EA" BorderThickness="1" CornerRadius="8" Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="Serviços criados automaticamente" Foreground="{StaticResource Muted}" FontSize="12" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="OnboardingServicesText" Foreground="{StaticResource Ink}" FontWeight="Bold" FontSize="15" TextWrapping="Wrap" LineHeight="21" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                                <Button Content="Criar agenda deste setor"
                                        Style="{StaticResource CommandButton}"
                                        MinWidth="190"
                                        Click="FinishOnboardingButton_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
