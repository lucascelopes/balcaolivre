                                  Visibility="Collapsed">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" Columns="3"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <Grid Grid.Row="3" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.04*"/>
                            <ColumnDefinition Width="1.10*"/>
                            <ColumnDefinition Width="1.30*"/>
                            <ColumnDefinition Width="0.98*"/>
                        </Grid.ColumnDefinitions>

                        <Border x:Name="LegacyEstablishmentClientsPanel" Grid.Column="0" Style="{StaticResource PanelCard}" Padding="18,18,18,10" Margin="0,0,12,0" MinHeight="318">
