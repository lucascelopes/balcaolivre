                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="StepChrome"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="10"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Left"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="StepChrome" Property="Background" Value="#242424"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="StepChrome" Property="Opacity" Value="0.78"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <Style x:Key="AppointmentModalPrimaryButtonStyle" TargetType="Button">
                            <Setter Property="Background" Value="{DynamicResource PrimaryActionBackground}"/>
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryActionForeground}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryActionBackground}"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="PrimaryChrome"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="{StaticResource AppActionRadius}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="PrimaryChrome" Property="Background" Value="{DynamicResource PrimaryActionHoverBackground}"/>
                                                <Setter TargetName="PrimaryChrome" Property="BorderBrush" Value="{DynamicResource PrimaryActionHoverBackground}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryActionForeground}"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="PrimaryChrome" Property="Background" Value="{DynamicResource PrimaryActionPressedBackground}"/>
                                                <Setter TargetName="PrimaryChrome" Property="BorderBrush" Value="{DynamicResource PrimaryActionPressedBackground}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryActionForeground}"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="PrimaryChrome" Property="Opacity" Value="0.45"/>
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="PrimaryChrome" Property="Opacity" Value="0.92"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
