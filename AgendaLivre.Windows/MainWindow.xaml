                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,8,0">
                            <TextBlock Text="Conversas" Foreground="{StaticResource Ink}" FontSize="15" FontWeight="Bold"/>
                            <TextBlock x:Name="WhatsAppFloatingStatusText" Text="Linke o WhatsApp da loja" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Button Grid.Column="2"
                                Width="30"
                                Height="30"
                                Padding="0"
                                Background="#F8FAFC"
                                Foreground="{StaticResource Ink}"
                                BorderBrush="#E2E8F0"
