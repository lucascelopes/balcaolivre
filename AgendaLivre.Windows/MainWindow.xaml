                                    <DropShadowEffect BlurRadius="18" ShadowDepth="5" Opacity="0.12" Color="#171411"/>
                                    </Border.Effect>
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      TextElement.Foreground="{TemplateBinding Foreground}"/>
