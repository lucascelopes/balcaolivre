                                        BorderThickness="0"
                                        Padding="0"
                                        Margin="0,10,0,0"
                                        HorizontalAlignment="Left"
                                        Cursor="Hand">
                                    <TextBlock x:Name="LegacyEstablishmentServicesTotalText" Text="0 serviços no catálogo" Foreground="{DynamicResource AccentText}" FontWeight="Bold" FontSize="12"/>
                                </Button>
                            </Grid>
                        </Border>

                        <Border Grid.Column="3" Style="{StaticResource PanelCard}" Padding="18" MinHeight="318">
                            <StackPanel>
                                <TextBlock Text="Resumo do mês" Foreground="{StaticResource Ink}" FontSize="15.5" FontWeight="Bold" Margin="0,0,0,16"/>

                                <Border Background="#FFFCFA" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="36" Height="36" Background="{DynamicResource AccentSoft}" CornerRadius="10">
                                            <materialDesign:PackIcon Kind="CalendarMonth" Foreground="{DynamicResource AccentForeground}" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Atendimentos" Foreground="{StaticResource Muted}" FontSize="12"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                                <TextBlock x:Name="LegacyEstablishmentMonthAppointmentsText" Text="0" Foreground="{StaticResource Ink}" FontWeight="Bold" FontSize="18"/>
                                                <TextBlock Text=" no mês" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="5,3,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Background="#F8FFFC" BorderBrush="#D8F3E7" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="36" Height="36" Background="#ECFDF5" CornerRadius="10">
                                            <materialDesign:PackIcon Kind="CashMultiple" Foreground="#16A34A" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Receita média" Foreground="{StaticResource Muted}" FontSize="12"/>
                                            <TextBlock x:Name="LegacyEstablishmentAverageRevenueText" Text="R$ 0,00" Foreground="{StaticResource Ink}" FontWeight="Bold" FontSize="18" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Background="#FFFBF7" BorderBrush="#FDE9D2" BorderThickness="1" CornerRadius="12" Padding="14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="36" Height="36" Background="#FFF7ED" CornerRadius="10">
                                            <materialDesign:PackIcon Kind="Star" Foreground="#F59E0B" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Receita do mês" Foreground="{StaticResource Muted}" FontSize="12"/>
                                            <TextBlock x:Name="LegacyEstablishmentMonthlyRevenueText" Text="R$ 0" Foreground="{StaticResource Ink}" FontWeight="Bold" FontSize="18" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="4" Visibility="Collapsed">
                        <Border x:Name="EstablishmentProductsPanel">
                            <ItemsControl x:Name="EstablishmentProductsItemsControl" ItemTemplate="{StaticResource EstablishmentListTemplate}"/>
                        </Border>
                        <Border x:Name="EstablishmentSalesPanel">
                            <ItemsControl x:Name="EstablishmentSalesItemsControl" ItemTemplate="{StaticResource EstablishmentListTemplate}"/>
                        </Border>
                    </StackPanel>
                    </Grid>
                </ScrollViewer>

            <ScrollViewer x:Name="FinanceView"
                          AutomationProperties.Name="Página Financeiro"
                          Grid.Column="1"
                          Margin="18,18,0,0"
                          Background="#FAF9F7"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="Collapsed">
                <ScrollViewer.Resources>
                    <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource AppSlimScrollBar}"/>
                    <Style x:Key="FinanceAnalyticsCard" TargetType="Border" BasedOn="{StaticResource PanelCard}">
                        <Setter Property="Padding" Value="14"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#ED6823"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                    <Style x:Key="FinanceKpiLabel" TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </Style>
                    <Style x:Key="FinanceKpiValue" TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                        <Setter Property="FontSize" Value="20"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Margin" Value="0,4,0,0"/>
                    </Style>
                    <Style x:Key="FinanceSectionTitle" TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                        <Setter Property="FontSize" Value="16"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                    </Style>
                    <Style x:Key="FinanceCaption" TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                        <Setter Property="FontSize" Value="10.5"/>
                    </Style>
                </ScrollViewer.Resources>

                <Grid Margin="0,0,18,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header and primary actions -->
                    <Grid Grid.Row="0" Margin="2,0,2,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="280"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="FINANCEIRO" Foreground="{DynamicResource AccentText}" FontSize="10" FontWeight="Bold"/>
                                <Border Width="44" Height="1" Background="{DynamicResource Accent}" Margin="12,6,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="FinanceAnalyticsTitleText" Text="Financeiro" Foreground="{StaticResource Ink}" FontSize="28" FontWeight="Bold"/>
                            <TextBlock Text="Resultado, agenda e riscos para decidir com mais segurança." Foreground="{StaticResource Muted}" FontSize="12.5" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                            <Border Height="40" MinWidth="146" Padding="12,0" Background="#FFFFFF" BorderBrush="#D8D3CE" BorderThickness="1" CornerRadius="14" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="CalendarMonthOutline" Width="17" Height="17" Foreground="#716B66" Margin="0,0,7,0"/>
                                    <TextBlock x:Name="FinancePeriodText" Text="Julho de 2026" Foreground="{StaticResource Ink}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Text="Mês atual" Foreground="#8D8782" FontSize="9.5" Margin="9,1,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Button x:Name="FinanceScenarioButton" Style="{StaticResource GhostButton}" Height="40" MinWidth="142" Padding="12,0" Margin="0,0,8,0" Click="FinanceSimulateScenarioButton_Click" AutomationProperties.Name="Atualizar análise financeira">
                                <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Refresh" Width="17" Height="17" Margin="0,0,7,0"/><TextBlock Text="Atualizar análise" VerticalAlignment="Center"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource CommandButton}" Height="40" MinWidth="164" Padding="12,0" Margin="0,0,8,0" Click="RegisterPaymentButton_Click" AutomationProperties.Name="Nova movimentação financeira">
                                <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Plus" Width="17" Height="17" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,7,0"/><TextBlock Text="Nova movimentação" VerticalAlignment="Center"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Height="40" MinWidth="96" Padding="12,0" Click="ExportReportButton_Click" AutomationProperties.Name="Exportar financeiro">
                                <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="DownloadOutline" Width="17" Height="17" Margin="0,0,7,0"/><TextBlock Text="Exportar" VerticalAlignment="Center"/></StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Five executive KPIs -->
                    <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,10">
                        <Border x:Name="FinanceRevenueKpiCard" Style="{StaticResource FinanceAnalyticsCard}" Margin="0,0,8,0" MinHeight="88" Cursor="Help">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Grid><TextBlock Text="Receita" Style="{StaticResource FinanceKpiLabel}"/><Border HorizontalAlignment="Right" Background="#FFF1E9" CornerRadius="9" Padding="7,3"><TextBlock x:Name="FinanceRevenueDeltaText" Text="+12%" Foreground="#B74716" FontSize="10" FontWeight="Bold"/></Border></Grid>
                                <TextBlock Grid.Row="1" Text="{Binding Text, ElementName=FinanceReceivedMonthText}" Style="{StaticResource FinanceKpiValue}"/>
                                <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,7,0,0"><Border Width="48" Height="4" CornerRadius="2" Background="#ED6823"/><TextBlock Text=" realizado no mês" Style="{StaticResource FinanceCaption}" Margin="5,-5,0,0"/></StackPanel>
                            </Grid>
                        </Border>
                        <Border x:Name="FinanceExpensesKpiCard" Style="{StaticResource FinanceAnalyticsCard}" Margin="0,0,8,0" MinHeight="88" Cursor="Help">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <TextBlock Text="Despesas registradas" Style="{StaticResource FinanceKpiLabel}"/>
                                <TextBlock x:Name="FinanceVariableCostsText" Grid.Row="1" Text="R$ 0,00" Style="{StaticResource FinanceKpiValue}"/>
                                <Grid Grid.Row="2" Margin="0,7,0,0"><Border Height="4" Background="#EEE9E5" CornerRadius="2" VerticalAlignment="Top"/><Border x:Name="FinanceVariableCostsBar" Height="4" Width="54" Background="#C95318" CornerRadius="2" HorizontalAlignment="Left" VerticalAlignment="Top"/><TextBlock x:Name="FinanceVariableCostsRatioText" Text="0% da receita" Style="{StaticResource FinanceCaption}" Margin="0,8,0,0"/></Grid>
                            </Grid>
                        </Border>
                        <Border x:Name="FinanceCommissionsKpiCard" Style="{StaticResource FinanceAnalyticsCard}" Margin="0,0,8,0" MinHeight="88" Cursor="Help">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <TextBlock Text="Comissões" Style="{StaticResource FinanceKpiLabel}"/>
                                <TextBlock x:Name="FinanceCommissionsText" Grid.Row="1" Text="R$ 0,00" Style="{StaticResource FinanceKpiValue}"/>
                                <Grid Grid.Row="2" Margin="0,7,0,0"><Border Height="4" Background="#EEE9E5" CornerRadius="2" VerticalAlignment="Top"/><Border x:Name="FinanceCommissionsBar" Height="4" Width="42" Background="#A44218" CornerRadius="2" HorizontalAlignment="Left" VerticalAlignment="Top"/><TextBlock x:Name="FinanceCommissionsRatioText" Text="0% da receita" Style="{StaticResource FinanceCaption}" Margin="0,8,0,0"/></Grid>
                            </Grid>
                        </Border>
                        <Border x:Name="FinanceResultKpiCard" Style="{StaticResource FinanceAnalyticsCard}" Margin="0,0,8,0" MinHeight="88" Cursor="Help">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <TextBlock Text="Resultado líquido" Style="{StaticResource FinanceKpiLabel}"/>
                                <TextBlock x:Name="FinanceNetProfitText" Grid.Row="1" Text="R$ 0,00" Foreground="#ED6823" FontSize="20" FontWeight="Bold" Margin="0,4,0,0"/>
                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,7,0,0"><Border Width="40" Height="18" Background="#1C1B1A" CornerRadius="8"><TextBlock x:Name="FinanceNetMarginText" Text="0%" Foreground="#FFFFFF" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text=" sobre recebimentos" Style="{StaticResource FinanceCaption}" Margin="5,1,0,0"/></StackPanel>
                            </Grid>
                        </Border>
                        <Border x:Name="FinancePendingKpiCard" Style="{StaticResource FinanceAnalyticsCard}" MinHeight="88" Cursor="Help">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Grid><TextBlock Text="Agenda a receber" Style="{StaticResource FinanceKpiLabel}"/><materialDesign:PackIcon Kind="CashClock" HorizontalAlignment="Right" Width="17" Height="17" Foreground="#ED6823"/></Grid>
                                <TextBlock x:Name="FinanceRiskExposureText" Grid.Row="1" Text="R$ 0,00" Style="{StaticResource FinanceKpiValue}"/>
                                <TextBlock x:Name="FinanceRiskExposureRatioText" Grid.Row="2" Text="0 atendimentos sem recebimento" Foreground="#B74716" FontSize="10.5" FontWeight="SemiBold" Margin="0,8,0,0"/>
                            </Grid>
                        </Border>
                    </UniformGrid>

                    <!-- Waterfall and scenarios -->
                    <Grid Grid.Row="2" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="2.12*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource FinanceAnalyticsCard}" Margin="0,0,10,0" MinHeight="220">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid Margin="0,0,0,8">
                                    <StackPanel><TextBlock Text="Formação do resultado" Style="{StaticResource FinanceSectionTitle}"/><TextBlock Text="Recebimentos menos despesas lançadas e comissões configuradas." Style="{StaticResource FinanceCaption}" Margin="0,2,0,0"/></StackPanel>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#FFF1E9" CornerRadius="9" Padding="9,4"><TextBlock Text="CASCATA" Foreground="#B74716" FontSize="9.5" FontWeight="Bold"/></Border>
                                </Grid>
                                <Viewbox Grid.Row="1" Stretch="Fill" Height="120">
                                    <Canvas x:Name="FinanceWaterfallCanvas" Width="760" Height="174"/>
                                </Viewbox>
