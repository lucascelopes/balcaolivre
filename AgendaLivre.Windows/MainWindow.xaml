                                                          Style="{StaticResource AppointmentComboBox}"
                                                          IsTabStop="False"
                                                          SelectionChanged="AppointmentSegmentCombo_SelectionChanged"/>
                                                <TextBox Style="{StaticResource AppointmentInputBox}"
                                                         Text="{Binding SelectedItem, ElementName=AppointmentSegmentCombo, Mode=OneWay}"
                                                         materialDesign:HintAssist.Hint="Segmento *"
                                                         IsReadOnly="True"
                                                         IsHitTestVisible="False"
                                                         Focusable="False"
                                                         IsTabStop="False"
                                                         Cursor="Arrow"
                                                          AutomationProperties.Name="Segmento do estabelecimento"
                                                          AutomationProperties.HelpText="Definido nas configurações do estabelecimento"/>
                                                <DatePicker x:Name="AppointmentDatePicker"
                                                            Grid.Column="2"
                                                            Style="{StaticResource AppointmentDatePicker}"
                                                            Language="pt-BR"
                                                            SelectedDateFormat="Short"
                                                            Loaded="AppointmentDatePicker_Loaded"
                                                            SelectedDateChanged="AppointmentSummaryInput_Changed"
                                                            materialDesign:HintAssist.Hint="Data *"
                                                            AutomationProperties.Name="Data do agendamento"/>
                                                <ComboBox x:Name="TimeCombo"
                                                          Grid.Row="2"
                                                          Style="{StaticResource AppointmentComboBox}"
                                                          SelectionChanged="AppointmentSummaryInput_Changed"
                                                          materialDesign:HintAssist.Hint="Horário *"
                                                          AutomationProperties.Name="Horário do agendamento"/>
                                                <ComboBox x:Name="DurationCombo"
                                                          Grid.Row="2"
                                                          Grid.Column="2"
                                                          Style="{StaticResource AppointmentComboBox}"
                                                          SelectionChanged="AppointmentSummaryInput_Changed"
                                                          materialDesign:HintAssist.Hint="Duração *"
                                                          AutomationProperties.Name="Duração do atendimento"/>
                                            </Grid>

                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <ComboBox x:Name="ServiceCombo"
                                                          Style="{StaticResource AppointmentComboBox}"
                                                          materialDesign:HintAssist.Hint="Serviço *"
                                                          DisplayMemberPath="DisplayName"
                                                          SelectionChanged="ServiceCombo_SelectionChanged"
                                                          AutomationProperties.Name="Serviço do agendamento"/>
                                                <TextBox x:Name="PriceTextBox"
                                                         Grid.Column="2"
                                                         Style="{StaticResource AppointmentInputBox}"
                                                         TextChanged="AppointmentSummaryInput_Changed"
                                                         materialDesign:HintAssist.Hint="Valor *"
                                                         materialDesign:TextFieldAssist.PrefixText="R$ "
                                                         Tag="0,00"
                                                         AutomationProperties.Name="Valor do atendimento"/>
                                            </Grid>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="ResourceLabelText" Text="Mesa ou cadeira *" Visibility="Collapsed"/>
                                                <ComboBox x:Name="ProfessionalCombo"
                                                          Style="{StaticResource AppointmentComboBox}"
                                                          SelectionChanged="AppointmentSummaryInput_Changed"
                                                          materialDesign:HintAssist.Hint="Profissional *"
                                                          DisplayMemberPath="Name"
                                                          AutomationProperties.Name="Profissional do atendimento"/>
                                                <ComboBox x:Name="ResourceCombo"
                                                          Grid.Column="2"
                                                          Style="{StaticResource AppointmentComboBox}"
                                                          SelectionChanged="AppointmentSummaryInput_Changed"
                                                          materialDesign:HintAssist.Hint="{Binding Text, ElementName=ResourceLabelText}"
                                                          AutomationProperties.Name="Recurso do atendimento"/>
                                            </Grid>

                                            <Grid Margin="0,12,0,0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="8"/>
                                                    <RowDefinition Height="58"/>
                                                </Grid.RowDefinitions>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <materialDesign:PackIcon Kind="AccountClockOutline"
                                                                             Width="18"
                                                                             Height="18"
                                                                             Foreground="{DynamicResource Ink}"
                                                                             VerticalAlignment="Center"
                                                                             Margin="0,0,8,0"/>
                                                    <TextBlock x:Name="AppointmentTimelineProfessionalText"
                                                               Grid.Column="1"
                                                               Text="Agenda do profissional"
                                                               Foreground="{DynamicResource Ink}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="Próximo horário livre:"
                                                                   Foreground="{DynamicResource Muted}"
                                                                   FontSize="10.5"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock x:Name="AppointmentTimelineNextFreeText"
                                                                   Text="--:--"
                                                                   Foreground="{DynamicResource AccentText}"
                                                                   FontSize="11.5"
                                                                   FontWeight="Bold"
                                                                   VerticalAlignment="Center"
                                                                   Margin="5,0,0,0"/>
                                                    </StackPanel>
                                                </Grid>

                                                <Grid Grid.Row="2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="30"/>
                                                        <ColumnDefinition Width="6"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="6"/>
                                                        <ColumnDefinition Width="30"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Button Style="{StaticResource AppointmentModalGhostButtonStyle}"
                                                            Width="30"
                                                            Height="58"
                                                            MinWidth="30"
                                                            Padding="0"
                                                            Click="AppointmentTimelineScrollLeftButton_Click"
                                                            ToolTip="Ver horários anteriores"
                                                            AutomationProperties.Name="Mover linha da agenda para a esquerda">
                                                        <materialDesign:PackIcon Kind="ChevronLeft" Width="18" Height="18"/>
                                                    </Button>

                                                    <ScrollViewer x:Name="AppointmentTimelineScrollViewer"
                                                                  Grid.Column="2"
                                                                  HorizontalScrollBarVisibility="Hidden"
                                                                  VerticalScrollBarVisibility="Disabled"
                                                                  CanContentScroll="False"
                                                                  PanningMode="HorizontalOnly"
                                                                  Cursor="Hand"
                                                                  PreviewMouseWheel="AppointmentTimelineScrollViewer_PreviewMouseWheel"
                                                                  PreviewMouseLeftButtonDown="AppointmentTimelineScrollViewer_PreviewMouseLeftButtonDown"
                                                                  PreviewMouseMove="AppointmentTimelineScrollViewer_PreviewMouseMove"
                                                                  PreviewMouseLeftButtonUp="AppointmentTimelineScrollViewer_PreviewMouseLeftButtonUp"
                                                                  LostMouseCapture="AppointmentTimelineScrollViewer_LostMouseCapture"
                                                                  AutomationProperties.Name="Linha horizontal de horários e serviços">
                                                        <StackPanel Orientation="Horizontal" Height="58">
                                                            <Border Width="128"
                                                                    Background="{DynamicResource AccentSoft}"
                                                                    BorderBrush="{DynamicResource Line}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="10,0,0,10"
                                                                    Padding="10,6">
                                                                <StackPanel>
                                                                    <TextBlock x:Name="AppointmentTimelinePreviousServiceText"
                                                                               Text="Horário anterior"
                                                                               Foreground="{DynamicResource Ink}"
                                                                               FontSize="10.5"
                                                                               FontWeight="SemiBold"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock x:Name="AppointmentTimelinePreviousTimeText"
                                                                               Text="12:00 – 12:30"
                                                                               Foreground="{DynamicResource Muted}"
                                                                               FontSize="9.5"
                                                                               Margin="0,3,0,0"/>
                                                                </StackPanel>
                                                            </Border>

                                                            <Border Width="112"
                                                                    Background="#F5F3F1"
                                                                    BorderBrush="{DynamicResource Line}"
                                                                    BorderThickness="0,1,1,1"
                                                                    Padding="10,6">
                                                                <StackPanel>
                                                                    <TextBlock Text="Intervalo"
                                                                               Foreground="{DynamicResource Ink}"
                                                                               FontSize="10.5"
                                                                               FontWeight="SemiBold"/>
                                                                    <TextBlock x:Name="AppointmentTimelineIntervalText"
                                                                               Text="12:30 – 13:00"
                                                                               Foreground="{DynamicResource Muted}"
                                                                               FontSize="9.5"
                                                                               Margin="0,3,0,0"/>
                                                                </StackPanel>
                                                            </Border>

                                                            <Border Width="250"
                                                                    Background="{DynamicResource PrimaryActionBackground}"
                                                                    BorderBrush="{DynamicResource PrimaryActionBackground}"
                                                                    BorderThickness="1"
                                                                    Padding="12,6">
                                                                <StackPanel HorizontalAlignment="Center">
                                                                    <TextBlock x:Name="AppointmentTimelineServiceText"
                                                                               Text="Serviço selecionado"
                                                                               Foreground="{DynamicResource PrimaryActionForeground}"
                                                                               FontSize="11"
                                                                               FontWeight="SemiBold"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               HorizontalAlignment="Center"/>
                                                                    <TextBlock x:Name="AppointmentTimelineSelectedTimeText"
                                                                               Text="13:00 – 15:00"
                                                                               Foreground="{DynamicResource PrimaryActionForeground}"
                                                                               FontSize="10"
                                                                               FontWeight="SemiBold"
                                                                               Margin="0,3,0,0"
                                                                               HorizontalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Border>

                                                            <Border Width="118"
                                                                    Background="#FFFFFF"
                                                                    BorderBrush="{DynamicResource Line}"
                                                                    BorderThickness="0,1,1,1"
                                                                    Padding="10,6">
                                                                <StackPanel>
                                                                    <TextBlock Text="Livre"
                                                                               Foreground="{DynamicResource Ink}"
                                                                               FontSize="10.5"
                                                                               FontWeight="SemiBold"/>
                                                                    <TextBlock x:Name="AppointmentTimelineFirstFreeTimeText"
                                                                               Text="15:00 – 15:30"
                                                                               Foreground="{DynamicResource Muted}"
                                                                               FontSize="9.5"
                                                                               Margin="0,3,0,0"/>
                                                                </StackPanel>
                                                            </Border>

                                                            <Border Width="118"
                                                                    Background="#FFFFFF"
                                                                    BorderBrush="{DynamicResource Line}"
                                                                    BorderThickness="0,1,1,1"
                                                                    CornerRadius="0,10,10,0"
                                                                    Padding="10,6">
                                                                <StackPanel>
                                                                    <TextBlock Text="Livre"
                                                                               Foreground="{DynamicResource Ink}"
                                                                               FontSize="10.5"
                                                                               FontWeight="SemiBold"/>
                                                                    <TextBlock x:Name="AppointmentTimelineSecondFreeTimeText"
                                                                               Text="15:30 – 16:00"
                                                                               Foreground="{DynamicResource Muted}"
                                                                               FontSize="9.5"
                                                                               Margin="0,3,0,0"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>
                                                    </ScrollViewer>

                                                    <Button Grid.Column="4"
                                                            Style="{StaticResource AppointmentModalGhostButtonStyle}"
                                                            Width="30"
                                                            Height="58"
                                                            MinWidth="30"
                                                            Padding="0"
                                                            Click="AppointmentTimelineScrollRightButton_Click"
                                                            ToolTip="Ver próximos horários"
                                                            AutomationProperties.Name="Mover linha da agenda para a direita">
                                                        <materialDesign:PackIcon Kind="ChevronRight" Width="18" Height="18"/>
                                                    </Button>
                                                </Grid>

                                                <Grid Visibility="Collapsed">
                                                    <TextBlock x:Name="AppointmentSummaryDateTimeText"/>
                                                    <TextBlock x:Name="AppointmentSummaryServiceText"/>
                                                    <TextBlock x:Name="AppointmentSummaryResourceText"/>
                                                    <TextBlock x:Name="AppointmentSummaryPriceText"/>
                                                </Grid>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border x:Name="AppointmentClientStep"
                                            Background="#FFFFFF"
                                            BorderBrush="{DynamicResource Line}"
                                            BorderThickness="{StaticResource AppSurfaceBorderThickness}"
                                            CornerRadius="{StaticResource AppSurfaceRadius}"
                                            Padding="15"
                                            Visibility="Collapsed">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,15">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="38" Height="38" Background="{DynamicResource AccentSoft}" CornerRadius="{StaticResource AppBadgeRadius}" Margin="0,0,10,0">
                                                    <materialDesign:PackIcon Kind="AccountOutline" Foreground="{DynamicResource AccentForeground}" Width="19" Height="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock x:Name="ClientSectionTitle" Grid.Column="1" Text="Cliente" Foreground="{StaticResource Ink}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <Button Grid.Column="2" Content="Cadastrar" Visibility="Collapsed" Style="{StaticResource GhostButton}" Height="28" MinWidth="84" Padding="9,0" FontSize="11.5" Click="NewCustomerQuickButton_Click" AutomationProperties.Name="Cadastrar cliente"/>
                                            </Grid>

                                            <Border Background="{DynamicResource Ink}"
                                                    CornerRadius="14"
                                                    Padding="16,12"
                                                    Margin="0,0,0,14">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock x:Name="AppointmentClientContextTitle"
                                                                   Text="Serviço selecionado"
                                                                   Foreground="#FFFFFF"
                                                                   FontSize="14"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock x:Name="AppointmentClientContextDetail"
                                                                   Text="Data, horário, profissional e recurso"
                                                                   Foreground="#FFFFFF"
                                                                   Opacity="0.68"
                                                                   FontSize="11.5"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="0,3,12,0"/>
                                                    </StackPanel>
                                                    <TextBlock x:Name="AppointmentClientContextPrice"
                                                               Grid.Column="1"
                                                               Text="R$ 0,00"
                                                               Foreground="{DynamicResource AccentOnDark}"
                                                               FontSize="18"
                                                               FontWeight="Bold"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>

                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="CustomerNameTextBox"
                                                         Style="{StaticResource AppointmentInputBox}"
                                                         TextChanged="CustomerNameTextBox_TextChanged"
                                                         materialDesign:HintAssist.Hint="Cliente *"
                                                         Tag="Nome do cliente"
                                                         AutomationProperties.Name="Nome do cliente"
                                                         AutomationProperties.HelpText="Digite parte do nome para ver e selecionar clientes já cadastrados."/>
                                                <Popup x:Name="CustomerSuggestionsPopup"
                                                       Grid.Column="0"
                                                       PlacementTarget="{Binding ElementName=CustomerNameTextBox}"
                                                       Placement="Bottom"
                                                       VerticalOffset="4"
                                                       AllowsTransparency="True"
                                                       StaysOpen="False"
                                                       PopupAnimation="Fade"
                                                       Closed="CustomerSuggestionsPopup_Closed">
                                                    <Border Width="{Binding ActualWidth, ElementName=CustomerNameTextBox}"
                                                            MaxHeight="320"
                                                            Background="{DynamicResource Panel}"
                                                            BorderBrush="{DynamicResource Line}"
                                                            BorderThickness="1"
                                                            CornerRadius="14">
                                                        <Border.Effect>
                                                            <DropShadowEffect BlurRadius="24"
                                                                              ShadowDepth="6"
                                                                              Opacity="0.18"
                                                                              Color="#29170F"/>
                                                        </Border.Effect>
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>
                                                            <Grid Margin="12,10,12,7">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="Clientes encontrados"
                                                                           Foreground="{StaticResource Ink}"
                                                                           FontSize="12"
                                                                           FontWeight="SemiBold"/>
                                                                <TextBlock x:Name="CustomerSuggestionsCountText"
                                                                           Grid.Column="1"
                                                                           Text="0 opções"
                                                                           Foreground="{StaticResource Muted}"
                                                                           FontSize="11.5"/>
                                                            </Grid>
                                                            <ListBox x:Name="CustomerSuggestionsListBox"
                                                                     Grid.Row="1"
                                                                     MaxHeight="260"
                                                                     Margin="4,0,4,5"
                                                                     Padding="0"
                                                                     Background="Transparent"
                                                                     BorderThickness="0"
                                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                                     MouseLeftButtonUp="CustomerSuggestionsListBox_MouseLeftButtonUp"
                                                                     AutomationProperties.Name="Opções de clientes cadastrados">
                                                                <ListBox.ItemContainerStyle>
                                                                    <Style TargetType="ListBoxItem">
                                                                        <Setter Property="Padding" Value="0"/>
                                                                        <Setter Property="Margin" Value="2,1"/>
                                                                        <Setter Property="Background" Value="Transparent"/>
                                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                                        <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                                                                        <Setter Property="Template">
                                                                            <Setter.Value>
                                                                                <ControlTemplate TargetType="ListBoxItem">
                                                                                    <Border x:Name="SuggestionChrome"
                                                                                            Background="{TemplateBinding Background}"
                                                                                            CornerRadius="10"
                                                                                            Padding="10,8">
                                                                                        <ContentPresenter/>
                                                                                    </Border>
                                                                                    <ControlTemplate.Triggers>
                                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                                            <Setter TargetName="SuggestionChrome" Property="Background" Value="{DynamicResource AccentSoft}"/>
                                                                                        </Trigger>
                                                                                        <Trigger Property="IsSelected" Value="True">
                                                                                            <Setter TargetName="SuggestionChrome" Property="Background" Value="{DynamicResource AccentSoft}"/>
                                                                                        </Trigger>
                                                                                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                                                            <Setter TargetName="SuggestionChrome" Property="Background" Value="{DynamicResource AccentSoft}"/>
                                                                                        </Trigger>
                                                                                    </ControlTemplate.Triggers>
                                                                                </ControlTemplate>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                    </Style>
                                                                </ListBox.ItemContainerStyle>
                                                                <ListBox.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="34"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <Border Width="30"
                                                                                    Height="30"
                                                                                    Background="{DynamicResource AccentSoft}"
                                                                                    CornerRadius="9"
                                                                                    VerticalAlignment="Center">
                                                                                <materialDesign:PackIcon Kind="AccountOutline"
                                                                                                         Foreground="{DynamicResource AccentForeground}"
                                                                                                         Width="16"
                                                                                                         Height="16"
                                                                                                         HorizontalAlignment="Center"
                                                                                                         VerticalAlignment="Center"/>
                                                                            </Border>
                                                                            <StackPanel Grid.Column="1"
                                                                                        Margin="8,0,8,0"
                                                                                        VerticalAlignment="Center">
                                                                                <TextBlock Text="{Binding Name}"
                                                                                           Foreground="{StaticResource Ink}"
                                                                                           FontSize="12.5"
                                                                                           FontWeight="SemiBold"
                                                                                           TextTrimming="CharacterEllipsis"/>
                                                                                <TextBlock Text="{Binding Detail}"
                                                                                           ToolTip="{Binding Detail}"
                                                                                           Foreground="{StaticResource Muted}"
                                                                                           FontSize="11"
                                                                                           Margin="0,2,0,0"
                                                                                           TextTrimming="CharacterEllipsis"/>
                                                                            </StackPanel>
                                                                            <materialDesign:PackIcon Grid.Column="2"
                                                                                                     Kind="ChevronRight"
                                                                                                     Foreground="{StaticResource Muted}"
                                                                                                     Width="17"
                                                                                                     Height="17"
                                                                                                     VerticalAlignment="Center"/>
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ListBox.ItemTemplate>
                                                            </ListBox>
                                                        </Grid>
                                                    </Border>
                                                </Popup>
                                                <TextBox x:Name="PhoneTextBox"
                                                         Grid.Column="2"
                                                         Style="{StaticResource AppointmentInputBox}"
                                                         materialDesign:HintAssist.Hint="Telefone / WhatsApp"
                                                         Tag="Telefone"
                                                         TextChanged="PhoneTextBox_TextChanged"
                                                         LostFocus="PhoneTextBox_LostFocus"
                                                         AutomationProperties.Name="Telefone do cliente"/>
                                            </Grid>

                                            <TextBlock x:Name="ProfileLabelText" Text="Preferência ou observação" Visibility="Collapsed"/>
                                            <TextBox x:Name="CustomerProfileTextBox"
                                                     Style="{StaticResource AppointmentInputBox}"
                                                     materialDesign:HintAssist.Hint="{Binding Text, ElementName=ProfileLabelText}"
                                                     Tag="Detalhe do atendimento"
                                                     Margin="0,0,0,12"
                                                     AutomationProperties.Name="Preferência ou detalhe do cliente"/>
                                            <TextBox x:Name="NotesTextBox"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     VerticalContentAlignment="Top"
                                                     Style="{StaticResource AppointmentMessageBox}"
                                                     materialDesign:HintAssist.Hint="Observações"
                                                     Tag="Observações internas do atendimento"
                                                     AutomationProperties.Name="Observações do atendimento"/>
                                        </StackPanel>
                                    </Border>

                                    <Border x:Name="AppointmentConfirmStep"
                                            Background="#FFFFFF"
                                            BorderBrush="{DynamicResource Line}"
                                            BorderThickness="{StaticResource AppSurfaceBorderThickness}"
                                            CornerRadius="{StaticResource AppSurfaceRadius}"
                                            Padding="18"
                                            Visibility="Collapsed">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="40" Height="40" Background="{DynamicResource AccentSoft}" CornerRadius="13" Margin="0,0,11,0">
                                                    <materialDesign:PackIcon Kind="CheckDecagramOutline" Foreground="{DynamicResource AccentForeground}" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="Revise antes de salvar" Foreground="{DynamicResource Ink}" FontSize="18" FontWeight="SemiBold"/>
                                                    <TextBlock Text="Confira os dados principais do agendamento." Foreground="{DynamicResource Muted}" FontSize="11.5" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Grid>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.12*"/>
                                                    <ColumnDefinition Width="14"/>
                                                    <ColumnDefinition Width="0.88*"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Background="{DynamicResource Ink}" CornerRadius="16" Padding="20,17">
                                                    <StackPanel>
                                                        <TextBlock Text="AGENDAMENTO" Foreground="{DynamicResource AccentOnDark}" FontSize="10" FontWeight="Bold"/>
                                                        <TextBlock x:Name="AppointmentConfirmDateTimeText"
                                                                   Text="Data e horário ainda não definidos"
                                                                   Foreground="#FFFFFF"
                                                                   FontSize="20"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="0,10,0,0"/>
                                                        <TextBlock x:Name="AppointmentConfirmServiceText"
                                                                   Text="Serviço não selecionado"
                                                                   Foreground="#FFFFFF"
                                                                   FontSize="14"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="0,9,0,0"/>
                                                        <TextBlock x:Name="AppointmentConfirmProfessionalText"
                                                                   Text="Profissional e recurso não definidos"
                                                                   Foreground="#FFFFFF"
                                                                   Opacity="0.68"
                                                                   FontSize="11.5"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="0,4,0,0"/>
                                                        <Border Height="1" Background="#FFFFFF" Opacity="0.14" Margin="0,15,0,12"/>
                                                        <TextBlock x:Name="AppointmentConfirmPriceText"
                                                                   Text="R$ 0,00"
                                                                   Foreground="{DynamicResource AccentOnDark}"
                                                                   FontSize="24"
                                                                   FontWeight="Bold"/>
                                                    </StackPanel>
                                                </Border>

                                                <Border Grid.Column="2"
                                                        Background="{DynamicResource AccentSoft}"
                                                        BorderBrush="{DynamicResource Line}"
                                                        BorderThickness="1"
                                                        CornerRadius="16"
                                                        Padding="20,17">
                                                    <StackPanel>
                                                        <TextBlock Text="CLIENTE" Foreground="{DynamicResource AccentText}" FontSize="10" FontWeight="Bold"/>
                                                        <TextBlock x:Name="AppointmentConfirmCustomerText"
                                                                   Text="Cliente não informado"
                                                                   Foreground="{DynamicResource Ink}"
                                                                   FontSize="17"
                                                                   FontWeight="SemiBold"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,12,0,0"/>
                                                        <Border Height="1" Background="{DynamicResource Line}" Margin="0,16,0,14"/>
                                                        <StackPanel Orientation="Horizontal">
                                                            <materialDesign:PackIcon Kind="ShieldCheckOutline" Foreground="{DynamicResource AccentForeground}" Width="18" Height="18" Margin="0,0,8,0"/>
                                                            <TextBlock Text="Dados prontos para confirmação" Foreground="{DynamicResource Muted}" FontSize="11.5" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <TextBlock Text="Ao salvar, o horário será validado contra conflitos de profissional e recurso."
                                                                   Foreground="{DynamicResource Muted}"
                                                                   FontSize="11"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,12,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
