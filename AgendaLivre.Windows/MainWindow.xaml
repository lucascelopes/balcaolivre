                                                <materialDesign:PackIcon Kind="CalendarMonth"
                                                                         Foreground="{DynamicResource AccentText}"
                                                                         Width="17"
                                                                         Height="17"
                                                                         Margin="0,0,7,0"/>
                                                <TextBlock Text="Escolher outra data" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <Grid x:Name="DatePopoverCalendarView" Visibility="Collapsed">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
