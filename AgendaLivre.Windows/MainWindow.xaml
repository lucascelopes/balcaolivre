    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border x:Name="CustomTitleBar"
                Grid.Row="0"
                Panel.ZIndex="2000"
                Background="#FFF5F1"
                BorderBrush="{DynamicResource Line}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="CustomTitleBar_MouseLeftButtonDown">
            <Border.Resources>
                <Style x:Key="WindowCaptionButton" TargetType="Button">
                    <Setter Property="Width" Value="46"/>
                    <Setter Property="Height" Value="31"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#4B413C"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="CaptionButtonSurface"
                                        Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="CaptionButtonSurface" Property="Background" Value="#F6E8E2"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="CaptionButtonSurface" Property="Background" Value="#EFD8CF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <Style x:Key="WindowCloseButton" TargetType="Button">
                    <Setter Property="Width" Value="46"/>
                    <Setter Property="Height" Value="31"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#4B413C"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="CloseButtonSurface"
                                        Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="CloseButtonSurface" Property="Background" Value="#F7DFDF"/>
                                        <Setter Property="Foreground" Value="#B4232C"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="CloseButtonSurface" Property="Background" Value="#EDC8C9"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Border.Resources>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Margin="10,0,0,0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False">
                    <Border Width="27" Height="18" Margin="0,0,7,0">
                        <Border.Background>
                            <ImageBrush ImageSource="Assets/agenda-livre-logo-source.png"
                                        Stretch="Uniform"
                                        Viewbox="328,194,1021,543"
                                        ViewboxUnits="Absolute"/>
                        </Border.Background>
                    </Border>
                    <TextBlock x:Name="WindowCaptionTitleText"
                               Text="Agenda Livre"
                               Foreground="#352D29"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource WindowCaptionButton}"
                            Click="CustomMinimizeButton_Click"
                            AutomationProperties.Name="Minimizar janela">
                        <materialDesign:PackIcon Kind="WindowMinimize" Width="13" Height="13"/>
                    </Button>
                    <Button x:Name="CustomMaximizeButton"
                            Style="{StaticResource WindowCaptionButton}"
                            Click="CustomMaximizeButton_Click"
                            AutomationProperties.Name="Maximizar janela">
                        <materialDesign:PackIcon x:Name="CustomMaximizeIcon"
                                                 Kind="WindowMaximize"
                                                 Width="12"
                                                 Height="12"/>
                    </Button>
                    <Button Style="{StaticResource WindowCloseButton}"
                            Click="CustomCloseButton_Click"
                            AutomationProperties.Name="Fechar janela">
                        <materialDesign:PackIcon Kind="Close" Width="15" Height="15"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
