                    <Border x:Name="WhatsAppFloatingDetailCard" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="8" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock x:Name="WhatsAppFloatingDetailText"
                                       Text="Confirmações, retornos e mensagens aparecem aqui."
                                       Foreground="{StaticResource Ink}"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="Confirme agenda e responda clientes sem sair do sistema."
                                       Foreground="{StaticResource Muted}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
