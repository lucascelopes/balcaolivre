                                    <Button Grid.Column="1" Content="Gerenciar" Tag="Clientes" Style="{StaticResource GhostButton}" Height="40" MinWidth="86" Padding="10,0" FontSize="12" Click="OpenEstablishmentSectionButton_Click"/>
