                        <ItemsControl x:Name="WhatsAppFloatingMessagesItemsControl"
                                      ItemTemplate="{StaticResource WhatsAppMessageTemplate}"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

