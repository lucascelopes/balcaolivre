                                        <Button Style="{StaticResource SoftAccentButton}" Click="NewCustomerQuickButton_Click" Height="40" MinWidth="126" HorizontalAlignment="Center" Margin="0,22,0,0" AutomationProperties.Name="Novo cliente">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Plus" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="Novo cliente" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Grid.Row="2" x:Name="LegacyEstablishmentClientsTotalText" Text="+0 clientes no total" Foreground="{DynamicResource AccentText}" FontWeight="Bold" FontSize="12" Margin="0,10,0,0"/>
                            </Grid>
                        </Border>

                        <Border x:Name="EstablishmentProfessionalsPanel" Grid.Column="1" Style="{StaticResource PanelCard}" Padding="18,18,18,10" Margin="0,0,12,0" MinHeight="318">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Equipe disponível" Foreground="{StaticResource Ink}" FontSize="15" FontWeight="Bold" TextWrapping="Wrap" MaxHeight="38" Margin="0,0,6,0"/>
                                    <Button Grid.Column="1" Content="Gerenciar" Tag="Profissionais" Style="{StaticResource GhostButton}" Height="40" MinWidth="86" Padding="10,0" FontSize="12" Click="OpenEstablishmentSectionButton_Click"/>
                                </Grid>
                                <ItemsControl Grid.Row="1" x:Name="LegacyEstablishmentProfessionalsItemsControl" ItemTemplate="{StaticResource EstablishmentListTemplate}" Cursor="Hand" MouseLeftButtonUp="EstablishmentProfessionalsItemsControl_MouseLeftButtonUp"/>
                                <TextBlock Grid.Row="2" x:Name="LegacyEstablishmentProfessionalsTotalText" Text="0 profissionais no total" Foreground="{DynamicResource AccentText}" FontWeight="Bold" FontSize="12" Margin="0,10,0,0"/>
                            </Grid>
                        </Border>

                        <Border x:Name="EstablishmentServicesPanel" Grid.Column="2" Style="{StaticResource PanelCard}" Padding="18,18,18,10" Margin="0,0,12,0" MinHeight="318">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Serviços cadastrados" Foreground="{StaticResource Ink}" FontSize="15" FontWeight="Bold" TextWrapping="Wrap" MaxHeight="38" Margin="0,0,6,0"/>
                                    <Button Grid.Column="1" Content="Gerenciar" Tag="Serviços" Style="{StaticResource GhostButton}" Height="40" MinWidth="86" Padding="10,0" FontSize="12" Click="OpenEstablishmentSectionButton_Click"/>
                                </Grid>
                                <ItemsControl Grid.Row="1" x:Name="LegacyEstablishmentServicesItemsControl" ItemTemplate="{StaticResource EstablishmentCompactListTemplate}" Cursor="Hand" MouseLeftButtonUp="EstablishmentServicesItemsControl_MouseLeftButtonUp"/>
