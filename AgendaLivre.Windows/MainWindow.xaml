                                    </Button>
                                    <Button Tag="Acompanhar todas as unidades" Style="{StaticResource WizardObjectiveButton}" Margin="8,0,8,16" Click="ObjectiveButton_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⌕" FontFamily="Segoe UI Symbol" FontSize="24" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="34"/>
                                            <TextBlock Text="Acompanhar todas as unidades" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </UniformGrid>
                            </ScrollViewer>
                            <Button x:Name="ContinueObjectiveButton"
                                    Grid.Row="2"
                                    Content="Continuar"
                                    Style="{StaticResource WizardPrimaryButton}"
                                    HorizontalAlignment="Center"
                                    Click="ContinueObjectiveButton_Click"/>
                        </Grid>

                        <Grid x:Name="AddressStepPanel" Visibility="Collapsed">
                            <StackPanel Width="610" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="Endereço do seu negócio"
                                           Foreground="{StaticResource Ink}"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Informe seu endereço para ser encontrado facilmente pelos clientes"
                                           Foreground="{DynamicResource Muted}"
                                           FontSize="14"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"
                                           Margin="0,14,0,28"/>
                                <TextBlock Text="CEP" Foreground="{DynamicResource Ink}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <TextBox x:Name="OnboardingCepTextBox"
                                         Style="{StaticResource WizardInput}"
                                         TextChanged="OnboardingCepTextBox_TextChanged"
                                         LostFocus="OnboardingCepTextBox_LostFocus"/>

                                <Grid Margin="0,20,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="176"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Bairro" Foreground="{DynamicResource Ink}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <TextBox x:Name="OnboardingNeighborhoodTextBox" Style="{StaticResource WizardInput}" Background="{DynamicResource WarmSoft}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Logradouro" Foreground="{DynamicResource Ink}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <TextBox x:Name="OnboardingStreetTextBox" Style="{StaticResource WizardInput}" Background="{DynamicResource WarmSoft}"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,20,0,34">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="176"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Número" Foreground="{DynamicResource Ink}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <TextBox x:Name="OnboardingAddressNumberTextBox" Style="{StaticResource WizardInput}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Complemento" Foreground="{DynamicResource Ink}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <TextBox x:Name="OnboardingAddressComplementTextBox" Style="{StaticResource WizardInput}"/>
                                    </StackPanel>
                                </Grid>

                                <Button Content="Continuar"
                                        Style="{StaticResource WizardPrimaryButton}"
                                        Click="ContinueAddressButton_Click"/>
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="ReviewStepPanel" Visibility="Collapsed">
                            <StackPanel Width="610" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="Revise e conclua"
                                           Foreground="{StaticResource Ink}"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Confira os dados principais antes de entrar no sistema."
                                           Foreground="{DynamicResource Muted}"
                                           FontSize="14"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"
                                           Margin="0,12,0,24"/>

                                <Border Background="{DynamicResource WarmSoft}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="18,8">
                                    <StackPanel>
                                        <Grid Margin="0,9">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Negócio" Foreground="{DynamicResource Muted}" FontSize="13"/>
                                            <TextBlock x:Name="OnboardingReviewBusinessText" Grid.Column="1" Foreground="{StaticResource Ink}" FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        </Grid>
                                        <Border Height="1" Background="{DynamicResource Line}"/>
                                        <Grid Margin="0,9">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Segmento" Foreground="{DynamicResource Muted}" FontSize="13"/>
                                            <TextBlock x:Name="OnboardingReviewSegmentText" Grid.Column="1" Foreground="{StaticResource Ink}" FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        </Grid>
                                        <Border Height="1" Background="{DynamicResource Line}"/>
                                        <Grid Margin="0,9">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Equipe e objetivo" Foreground="{DynamicResource Muted}" FontSize="13"/>
                                            <TextBlock x:Name="OnboardingReviewOperationText" Grid.Column="1" Foreground="{StaticResource Ink}" FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        </Grid>
                                        <Border Height="1" Background="{DynamicResource Line}"/>
                                        <Grid Margin="0,9">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Endereço" Foreground="{DynamicResource Muted}" FontSize="13"/>
                                            <TextBlock x:Name="OnboardingReviewAddressText" Grid.Column="1" Foreground="{StaticResource Ink}" FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Button Content="Concluir configuração"
                                        Style="{StaticResource WizardPrimaryButton}"
                                        MinWidth="430"
                                        Margin="0,28,0,0"
                                        AutomationProperties.Name="Concluir configuração"
                                        Click="FinishCreateAccountButton_Click"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border x:Name="StatusToastBorder"
                Grid.RowSpan="3"
                Panel.ZIndex="1000"
                Width="Auto"
                MaxWidth="520"
                MinHeight="48"
                Margin="24,24,24,30"
                Padding="15,11"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Background="{DynamicResource Accent}"
                BorderBrush="#40FFFFFF"
                BorderThickness="1"
                CornerRadius="{StaticResource AppActionRadius}"
                Visibility="Collapsed"
                Opacity="0"
                IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="5" Opacity="0.23" Color="#171411"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <materialDesign:PackIcon x:Name="StatusToastIcon"
                                         Kind="InformationOutline"
                                         Width="21"
                                         Height="21"
                                         Margin="0,0,10,0"
                                         Foreground="#FFFFFF"
                                         VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusToastText"
                           Grid.Column="1"
                           Text="Ação concluída."
                           Foreground="#FFFFFF"
                           FontSize="13.5"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           AutomationProperties.LiveSetting="Assertive"/>
            </Grid>
        </Border>
    </Grid>
</Window>
