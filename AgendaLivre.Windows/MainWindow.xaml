                                                       Width="21"
                                                       Height="25"
                                                       RadiusX="5"
                                                       RadiusY="5"
                                                       Fill="#60A5FA"/>
                                            <Rectangle Canvas.Left="10"
                                                       Canvas.Top="10"
                                                       Width="14"
                                                       Height="3"
                                                       RadiusX="1.5"
                                                       RadiusY="1.5"
                                                       Fill="#0F172A"/>
                                            <Rectangle Canvas.Left="10"
                                                       Canvas.Top="18"
                                                       Width="10"
                                                       Height="3"
                                                       RadiusX="1.5"
                                                       RadiusY="1.5"
                                                       Fill="#0F172A"/>
                                            <Path Fill="#60A5FA"
