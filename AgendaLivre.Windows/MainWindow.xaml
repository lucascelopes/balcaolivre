                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Background="#99000000"
                BorderBrush="#40FFFFFF"
                BorderThickness="1"
                CornerRadius="{StaticResource AppActionRadius}"
                Visibility="Collapsed"
                Opacity="0"
                IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="5" Opacity="0.23" Color="#171411"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <materialDesign:PackIcon x:Name="StatusToastIcon"
                                         Kind="InformationOutline"
                                         Width="21"
                                         Height="21"
                                         Margin="0,0,10,0"
                                         Foreground="#FFFFFF"
                                         VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusToastText"
                           Grid.Column="1"
                           Text="Ação concluída."
                           Foreground="#FFFFFF"
                           FontSize="13.5"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           AutomationProperties.LiveSetting="Assertive"/>
            </Grid>
        </Border>
        </Grid>
    </Grid>
</Window>
