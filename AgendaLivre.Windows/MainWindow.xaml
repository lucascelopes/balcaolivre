                            Style="{StaticResource GhostButton}"
                            Width="128"
                            HorizontalAlignment="Stretch"
                            Click="DateFilterButton_Click"
                            AutomationProperties.Name="Selecionar data da agenda"
                            AutomationProperties.HelpText="Abre uma faixa de sete dias e atalhos para escolher a data."/>

